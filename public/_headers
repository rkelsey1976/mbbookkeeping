# Netlify custom response headers.
# https://docs.netlify.com/routing/headers/
#
# Security headers only — no Content-Security-Policy yet. GA4 (via
# googletagmanager.com) and the Google Maps embed on /contact/ both load
# after cookie consent and inject inline script, so a CSP needs nonces or
# an allowlist worked out per-origin. Add it once those are enumerated.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Fingerprinted build assets never change — cache hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
