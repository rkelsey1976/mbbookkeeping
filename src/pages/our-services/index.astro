---
import PageLayout from '../../layouts/PageLayout.astro';
import { PHONE, BRAND, EMAIL, ADDRESS, COMPANY, PROFILES } from '../../lib/contact';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SERVICES } from '../../lib/services';
import { AREAS } from '../../lib/areas';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'AccountingService'],
  '@id': 'https://www.mbbookkeepingandpayrollsolutions.co.uk/#organization',
  name: BRAND.fullName,
  url: 'https://www.mbbookkeepingandpayrollsolutions.co.uk',
  telephone: '+447828742991',
  logo: 'https://www.mbbookkeepingandpayrollsolutions.co.uk/icon-512.png',
  email: EMAIL,
  legalName: COMPANY.legalName,
  sameAs: PROFILES,
  address: {
    '@type': 'PostalAddress',
    streetAddress: ADDRESS.street,
    addressLocality: ADDRESS.locality,
    postalCode: ADDRESS.postcode,
    addressCountry: 'GB',
  },
  areaServed: AREAS.map((a) => ({ '@type': 'Place', name: a.name })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '17:30',
    },
  ],
  priceRange: '££',
};
---

<PageLayout
  title="Our Services | Bookkeeping, Payroll & Accounting | MB Bookkeeping"
  description="Bookkeeping, payroll, VAT returns and MTD support, self assessment, bank reconciliation, management accounts and cloud accounting setup across Yate, Bristol and South Gloucestershire."
  canonical="/our-services/"
  schema={localBusiness}
  breadcrumbs={[{ name: 'Our Services', href: '/our-services/' }]}
  ctaHeading="Not sure which service you need?"
  ctaText="Tell us about your business and we'll recommend the right support. Free consultation, no pressure."
  ctaLabel="Book a Free Consultation"
>
  <Hero
    size="compact"
    eyebrow={['Our services']}
    title="Accounting & payroll services in"
    titleAccent="Bristol & South Glos"
    lede={`Seven services covering bookkeeping, payroll, VAT and MTD, self assessment and management accounts across ${AREAS.length} Bristol-area neighbourhoods.`}
    primaryCta={{ label: 'Book a Free Consultation', href: '/contact/#lead-form-heading' }}
    phone={{ number: PHONE.tel, display: PHONE.display }}
    trust={['Seven services', `${AREAS.length} neighbourhoods`, 'Free first consultation']}
    image="/hero/hero-bookkeeping.webp"
    imageAlt="Calculator on printed financial reports and charts"
  />

  <section class="section" id="services-grid">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow eyebrow--clay">What we do</span>
        <h2>What we do</h2>
        <p class="lede">Bookkeeping, payroll, VAT, self assessment and management accounts — every service kept accurate, on time and priced clearly, across Yate, Bristol and South Gloucestershire.</p>
      </header>

      <div class="service-grid-3">
        {SERVICES.map((service, i) => (
          <ServiceCard
            slug={service.slug}
            shortName={service.shortName}
            tagline={service.tagline}
            imageSrc={`/hero/card-${service.slug}.webp`}
            imageAlt={`${service.shortName} — MB Bookkeeping & Payroll Solutions`}
            number={String(i + 1).padStart(2, '0')}
            variant="default"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Coverage strip: the service cards above carry the "what"; this is the
       "where". Links go to each service's coverage within the matrix. -->
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Coverage</span>
        <h2>Where we work</h2>
        <p class="lede">
          Covering Bristol city and its suburbs, the North-East towns, and out to
          Portishead, Nailsea, Clevedon and Keynsham — our office is in Yate.
        </p>
      </header>

      <p class="coverage-link-row">
        <a href="/contact/" class="btn btn--primary">Book a free consultation</a>
      </p>
      <p class="coverage-note">
        Every neighbourhood we serve has its own page under each service — local
        context, not a directory.
      </p>
    </div>
  </section>

</PageLayout>

<style>
  .coverage-link-row {
    margin: var(--sp-5) 0 0;
    text-align: center;
  }
</style>