---
import PageLayout from '../layouts/PageLayout.astro';
import AreaCoverage from '../components/AreaCoverage.astro';
import Hero from '../components/Hero.astro';
import { AREAS } from '../lib/areas';
import { BRAND, PHONE, EMAIL, ADDRESS } from '../lib/contact';
import { SERVICES } from '../lib/services';

// What the practice does — structural facts from the live site, kept honest.
const whatWeDo = [
  'Bookkeeping — purchase and sales ledgers, data entry, kept up to date',
  'Bank reconciliations — done and checked, so the numbers can be trusted',
  'Payroll management — runs on time, HMRC-compliant, payslips handled',
  'VAT returns and Making Tax Digital support',
  'Self assessment — completed and filed',
  'Regular financial reports — who owes you, what you owe, where you stand',
  'Cloud accounting — set up and supported in Xero, QuickBooks or Sage',
] as const;

// PITCH PROPOSAL: software partners + MTD claim to be confirmed with the
// client before any live build. No accreditations or review claims are shown
// because the live site publishes none.
---

<PageLayout
  title="About MB Bookkeeping & Payroll Solutions | Yate, Bristol"
  description="MB Bookkeeping & Payroll Solutions is a bookkeeping and payroll practice serving small businesses across Bristol and South Gloucestershire. Bookkeeping, payroll, VAT and MTD support, self assessment and management accounts."
  canonical="/about-us/"
  breadcrumbs={[{ name: 'About Us', href: '/about-us/' }]}
>
  <Hero
    size="compact"
    eyebrow={['About us']}
    title="The bookkeeper on"
    titleAccent="your side."
    lede="A bookkeeping and payroll practice for small businesses across Bristol and South Gloucestershire — accurate books, tidy payroll, no jargon."
    primaryCta={{ label: 'Book a Free Consultation', href: '/contact/#lead-form-heading' }}
    phone={{ number: PHONE.tel, display: PHONE.display }}
    trust={['Bristol & South Glos', 'Free first consultation', 'MTD-ready']}
    image="/hero/hero-about.webp"
    imageAlt="Hands working through accounts with a calculator and notebook"
  />

  <section class="section">
    <div class="container container--reading">
      <p class="lede">
        MB Bookkeeping &amp; Payroll Solutions looks after the books for small businesses
        across Bristol and South Gloucestershire — the shops, trades, contractors and
        professional firms that are established and busy but don't have an in-house
        finance person. Our office is on Reed Road in Yate, on the North-East edge of
        the city.
      </p>
      <p>
        Most of our clients came to us the same way: the books had slipped behind, the
        accountant was asking questions at year end, and VAT or payroll had become the
        thing that ate their evenings. We take those jobs over, keep them current, and
        hand back figures you can actually read — so your accountant's job is cheaper,
        and yours is easier.
      </p>
      <p>
        You stay in the software you already use. We work with Xero, QuickBooks, Sage
        and FreeAgent, and we're set up for Making Tax Digital from day one.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What we do</h2>
      <p class="lede">The seven services the practice is built around:</p>
      <ul class="what-we-do">
        {whatWeDo.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p><a href="/our-services/" class="btn btn--secondary">See all services</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container container--reading">
      <h2>How we work</h2>
      <p>
        Everything starts with a free consultation — a conversation about what your
        business needs, not a sales pitch. If we're a fit, we agree a way of working
        and a price you've seen in writing before anything starts. You send us your
        paperwork or give us access to your software; we do the rest, on the schedule
        we agreed.
      </p>
      <p>
        You'll hear from us regularly — not just at year end. If something looks wrong
        in the numbers, you'll know from us before you hear it from your accountant.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <AreaCoverage
        eyebrow="Where we cover"
        heading={`${AREAS.length} neighbourhoods across Bristol and South Gloucestershire`}
        lede="Covering Bristol city, the suburbs and the surrounding towns. Not listed? Ask."
      />
    </div>
  </section>
</PageLayout>

<style>
  .what-we-do {
    list-style: none;
    margin: var(--sp-4) 0 var(--sp-5);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-3);
  }
  .what-we-do li {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--sp-4);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>