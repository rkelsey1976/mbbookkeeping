---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import { PHONE, WHATSAPP_NUMBER } from '../lib/contact';

// General questions about hiring MB Bookkeeping & Payroll Solutions.
// Service-specific questions (pricing detail, process per service) live on
// the seven service pages, so this page covers the engagement itself.
// No invented prices, accreditations or claims — honest-empty rule.
const faqs = [
  { q: 'What does MB Bookkeeping & Payroll Solutions actually do?', a: 'Bookkeeping — purchase and sales ledgers, data entry and bank reconciliations kept up to date; payroll management run on time and HMRC-compliant; VAT returns filed under Making Tax Digital; self assessment; regular financial reports; and cloud accounting setup and support. Seven services for small businesses across Bristol and South Gloucestershire.' },
  { q: 'Do I need a bookkeeper if I have an accountant?', a: 'Yes, usually — they do different jobs. Your accountant handles year-end accounts, tax planning and filings; we keep the day-to-day books accurate all year so your accountant gets clean figures and their bill stays lower. Most accountants are glad of a bookkeeper who keeps the records tidy.' },
  { q: 'How does pricing work?', a: 'It depends on what you need and how busy your books are — monthly transaction volume, payroll headcount, VAT scheme. We agree a fixed monthly price in writing after a free consultation, so you always know what you are paying before anything starts. No hourly surprises.' },
  { q: 'How do we start?', a: 'With a free consultation — a conversation about your business, your software and what needs doing. If we are a fit, we agree the scope and price in writing, then get set up. Nothing starts until you have seen it all in writing.' },
  { q: 'What software do you work with?', a: 'Xero, QuickBooks, Sage and FreeAgent. If you already use one, we work in it — no forced migrations. If you are still on spreadsheets, we can set you up properly in a cloud package and show you around it.' },
  { q: 'Do you handle Making Tax Digital?', a: 'Yes. VAT returns are filed digitally under MTD from day one, and we keep records in a digital format that meets the rules as they tighten. If MTD for income tax applies to you, self assessment is part of what we do.' },
  { q: 'Do you do payroll?', a: 'Yes — full payroll management: payslips, PAYE filings to HMRC, pensions enrolment handling, starters and leavers, and year-end forms. Payroll runs on your schedule, on time, every time.' },
  { q: 'Which areas do you cover?', a: 'The whole of Bristol and South Gloucestershire — the city and its suburbs, Yate, Chipping Sodbury, Bradley Stoke, Thornbury, Kingswood, down to Portishead, Nailsea, Clevedon and Keynsham. Every neighbourhood has its own page under each service. Our office is on Reed Road in Yate.' },
  { q: 'Can we meet face to face?', a: 'Yes — around Yate and North-East Bristol we are minutes away. Further out, phone, video and email work just as well; most of the work happens in your software either way, where you can see it.' },
  { q: 'Will my accountant be happy about this?', a: 'Almost certainly. We hand over reconciled books and clear reports, in the format your accountant asks for. Ask them — most will tell you a good bookkeeper saves them (and you) money at year end.' },
  { q: 'How do payments work?', a: 'A fixed monthly fee, agreed in writing, invoiced monthly. No deposit, no lock-in contract — you stay because the books are good, not because you are tied in.' },
  { q: 'Your question is not here', a: `The seven service pages carry more specific questions on pricing, process and scope per service. Or ask us directly: call ${PHONE.display}${WHATSAPP_NUMBER ? ' (or WhatsApp the same number)' : ''}, or send the form and we will come back the same working day.` },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<PageLayout
  title="FAQs | Bookkeeping & Payroll in Bristol | MB Bookkeeping"
  description="Straight answers on hiring a bookkeeper: what we do, pricing, software, MTD, payroll, coverage and how working with MB Bookkeeping & Payroll Solutions runs."
  canonical="/faqs/"
  schema={faqSchema}
  breadcrumbs={[{ name: 'FAQs', href: '/faqs/' }]}
  ctaHeading="Got a question we haven't answered?"
  ctaText={`Call ${PHONE.display} or send a message and we'll get back to you the same working day.`}
  ctaLabel="Get in touch"
>
  <Hero
    size="compact"
    eyebrow={['FAQs']}
    title="Frequently asked"
    titleAccent="questions."
    lede="Straight answers about hiring a bookkeeper — what we do, pricing, software, Making Tax Digital and how the work runs. Service-specific questions live on each service page."
    primaryCta={{ label: 'Ask us directly', href: '/contact/#lead-form-heading' }}
    phone={{ number: PHONE.tel, display: PHONE.display }}
    image="/hero/hero-contact.webp"
    imageAlt="Organised desk with notebook, calculator and financial charts"
  />

  <section class="section">
    <div class="container container--reading">
      <div class="faq-section">
        {faqs.map(f => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-answer">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
</PageLayout>