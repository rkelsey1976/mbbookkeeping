---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import AreaCoverage from '../../components/AreaCoverage.astro';
import BenefitGrid from '../../components/BenefitGrid.astro';
import ProcessTimeline from '../../components/ProcessTimeline.astro';
import MaterialGrid from '../../components/MaterialGrid.astro';
import ReviewCards from '../../components/ReviewCards.astro';
import AuthorityBio from '../../components/AuthorityBio.astro';
import ProblemList from '../../components/ProblemList.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ServiceBullets from '../../components/ServiceBullets.astro';
import { SERVICES, getService, getRelatedServices, warrantyBadge } from '../../lib/services';
import { AREAS } from '../../lib/areas';
import { REVIEWS } from '../../lib/reviews';
import { getCollection } from 'astro:content';
import { getBathAreas } from '../../lib/areas';
import { BRAND } from '../../lib/contact';
import { getCasesForService } from '../../lib/caseServiceMap';

const areaCount = getBathAreas().length;


export function getStaticPaths() {
  return SERVICES.filter((s) => s.city === 'bristol').map((service) => ({
    params: { service: service.slug },
  }));
}

const { service: slug } = Astro.params;
const serviceSlug = slug!;
const service = getService(serviceSlug);
if (!service) throw new Error(`Service not found: ${slug}`);

const relatedServices = getRelatedServices(serviceSlug);

// Real case studies for this service (from the /projects/ portfolio).
// Empty on the MB mock — nothing is invented for a real business.
const allStudies = await getCollection('caseStudies');
const serviceCases = getCasesForService(serviceSlug)
  .map((id) => allStudies.find((s) => s.id === id))
  .filter((s): s is NonNullable<typeof s> => Boolean(s))
  .slice(0, 2);

// shortName is a label, not a noun phrase: "Payroll Services" reads
// wrong mid-sentence ("the payroll services work we take on"). This is
// the prose form — headings still use the full shortName.
const serviceProse = service.shortName.replace(/\s+Services$/i, '').toLowerCase();
// Title-case form for headings that read as a sentence: "How Much Does
// Payroll Services Cost?" is not English.
const serviceTitle = service.shortName.replace(/\s+Services$/i, '');

// Guides naming this service. Capped at two: the point is a relevant link
// down and a link back up, not a link farm. Empty on the mock (blog is
// empty until the client signs).
const guides = (await getCollection('blog', ({ data }) =>
  !data.draft && (data.service === service.slug || data.alsoService === service.slug)
)).slice(0, 2);

const reviewsForService = REVIEWS
  .filter((r) => r.service.toLowerCase().includes(service.shortName.toLowerCase().split(' ')[0]))
  .slice(0, 3);

// Hero photography — Unsplash (free licence), chosen per service theme.
const heroImages: Record<string, string> = {
  'bookkeeping':           '/hero/hero-bookkeeping.webp',
  'payroll':               '/hero/hero-payroll.webp',
  'vat-returns':           '/hero/hero-vat-returns.webp',
  'self-assessment':       '/hero/hero-vat-returns.webp',
  'bank-reconciliation':   '/hero/hero-bookkeeping.webp',
  'management-accounts':   '/hero/hero-payroll.webp',
  'cloud-accounting':      '/hero/hero-payroll.webp',
};
const heroAlts: Record<string, string> = {
  'bookkeeping':           'Calculator on printed financial reports and charts',
  'payroll':               'Laptop showing a finance dashboard with charts and KPIs',
  'vat-returns':           'Tax paperwork, calculator and folders being reviewed',
  'self-assessment':       'Tax paperwork, calculator and folders being reviewed',
  'bank-reconciliation':   'Calculator on printed financial reports and charts',
  'management-accounts':   'Laptop showing a finance dashboard with charts and KPIs',
  'cloud-accounting':      'Laptop showing cloud accounting software',
};

// Build comprehensive Service + LocalBusiness + FAQPage + Offer schema
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: service.shortName,
    name: service.name,
    description: service.longIntro,
    provider: {
      '@type': 'LocalBusiness',
      name: 'MB Bookkeeping & Payroll Solutions',
      '@id': 'https://www.mbbookkeepingandpayrollsolutions.co.uk/#organization',
      telephone: '+447828742991',
      email: 'info@mbbookkeepingandpayrollsolutions.co.uk',
      url: 'https://www.mbbookkeepingandpayrollsolutions.co.uk',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '18 Reed Road',
        addressLocality: 'Yate',
        postalCode: 'BS37 7DR',
        addressCountry: 'GB',
      },
      areaServed: AREAS.map((a) => ({ '@type': 'Place', name: a.name })),
      // AggregateOffer and OfferCatalog removed. They published unconfirmed
      // price bands as structured data — restore only with signed-off figures.
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `The ${serviceProse} process, step by step`,
    description: `How MB Bookkeeping & Payroll Solutions runs ${serviceProse} for businesses across Bristol and South Gloucestershire, from the free consultation to the regular reports.`,
    step: service.processSteps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.description,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: `https://www.mbbookkeepingandpayrollsolutions.co.uk/${slug}/`,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.intro-split__copy p', '.faq-section details:first-of-type'],
    },
  },
];
---

<PageLayout
  title={service.titleTemplate}
  description={service.metaDescription}
  canonical={`/${slug}/`}
  ogImage={`/og/${service.slug}.jpg`}
  breadcrumbs={[{ name: 'Our Services', href: '/our-services/' }, { name: service.shortName, href: `/${service.slug}/` }]}
  prefillService={service.shortName}
  schema={schema}
  formHeading={`Book Your Free ${serviceTitle} Consultation`}
>
  <Hero
    size="compact"
    eyebrow={[`${service.shortName} in Bristol & South Gloucestershire`]}
    title={service.name}
    lede={service.intro}
    primaryCta={{ label: 'Book a Free Consultation', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+447828742991', display: '07828 742991' }}
    image={heroImages[service.slug] ?? '/hero/hero-bookkeeping.webp'}
    imageAlt={heroAlts[service.slug] ?? 'Bookkeeping workspace with calculator and financial reports'}
    trust={['Free first consultation', 'MTD-ready', warrantyBadge(service)]}
  />

  <section class="section">
    <div class="container container--reading">
      <p>{service.longIntro}</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <ServiceBullets
        eyebrow="What we do"
        items={service.whatWeDo}
        variant="do"
        columns={4}
        heading="What We Do"
        lede={`The ${serviceProse} work we take on across Yate, Bristol and South Gloucestershire — every business type, every setup.`}
      />
    </div>
  </section>

  {/* Named jobs people search for individually. Anchored so a GBP entry can
      deep-link straight to the right block instead of needing a thin page
      of its own. */}
  {service.subServices && (
    <section class="section" aria-labelledby="sub-services-heading">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Specific jobs</span>
          <h2 id="sub-services-heading">{serviceProse} we're asked for by name</h2>
          <p class="lede">Each is part of the same service — tell us which one you need and we'll price it on its own.</p>
        </header>
        <ul class="subsvc">
          {service.subServices.map((sub) => (
            <li id={sub.id} class="subsvc__item">
              <h3 class="subsvc__name">{sub.name}</h3>
              <p class="subsvc__summary">{sub.summary}</p>
              <a class="subsvc__cta" href="/contact/#lead-form-heading">
                Ask about this
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}


  <section class="section section--alt">
    <div class="container">
    <ProblemList
    eyebrow="Common problems"
      problems={service.problems}
      heading={`Signs you need ${serviceProse}`}
      lede="If any of these sound like your business, it's worth booking a free consultation."
    />
    </div>
  </section>

  <section class="section">
    <div class="container">
    <BenefitGrid
    eyebrow="Why us"
      benefits={service.benefits}
      heading={`Why Choose ${serviceTitle}`}
      lede={`Here's what working with MB gives you — accuracy, timeliness and numbers you can read.`}
    />
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
    <ProcessTimeline
    eyebrow="How it works"
      steps={service.processSteps}
      heading="Our Process"
      lede={`How ${serviceProse} runs with MB — from the free consultation to the regular rhythm of work and reporting.`}
    />
    </div>
  </section>


  {/* Pricing: generic UK guide ranges only — no area-level pricing and no
      invented specifics for a real business (CPRs 2008). Rendered only when
      the service data carries a guide. */}
  {service.costGuide && service.costGuide.length > 0 && (
    <section class="section">
      <div class="container">
        <MaterialGrid
        eyebrow="Pricing"
          materials={service.costGuide}
          heading={`What ${serviceTitle} Costs`}
          lede="Indicative UK guide ranges only — your price depends on your volumes and setup, and is agreed in writing before anything starts."
        />
      </div>
    </section>
  )}

  {/* Real case studies — only rendered when the service genuinely has one;
      none are fabricated for the pitch mock. */}
  {serviceCases.length > 0 && (
    <section class="section section--alt" aria-labelledby="case-studies-heading">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Real projects</span>
          <h2 id="case-studies-heading">Recent {service.shortName} work</h2>
          <p class="lede">A real job we've completed — the brief, the challenge, how it ran.</p>
        </header>
        <div class="case-band">
          {serviceCases.map(({ id, data: c }) => (
            <a href={`/projects/${id}/`} class="case-band__card">
              <span class="case-band__media">
                <img
                  src={c.image}
                  alt={`${c.title} in ${c.location} by MB Bookkeeping & Payroll Solutions`}
                  width="920" height="613" loading="lazy" decoding="async"
                />
                <span class="case-band__count">{c.gallery.length} photos</span>
              </span>
              <span class="case-band__body">
                <span class="case-band__title">{c.title}</span>
                <span class="case-band__loc">{c.location}</span>
                <span class="case-band__brief">{c.brief}</span>
                <span class="case-band__go">
                  Read the case study
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                       stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {reviewsForService.length > 0 && (
    <ReviewCards
      eyebrow="Reviews"
      reviews={reviewsForService}
      heading={`${service.shortName} Reviews`}
      lede={`Words from the businesses we look after.`}
    />
  )}

  <section class="section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Questions</span>
        <h2>Frequently Asked Questions</h2>
        <p class="lede">Everything you need to know about our {service.shortName.toLowerCase()} service.</p>
      </header>
      <div class="faq-section">
        {service.faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <div class="faq-answer">
              <p>{f.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <RelatedServices services={relatedServices} eyebrow="What else" />

  {/* Founder bio removed — MB's ownership details are not published and the
      honest-empty rule forbids inventing a named founder bio for the mock.
      The AuthorityBio component is intact and renders the moment real
      verified details exist. */}

  {guides.length > 0 && (
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Before you commit</span>
          <h2>Worth reading first</h2>
        </header>
        <ul class="svc-guides">
          {guides.map((g) => (
            <li>
              <a href={`/blog/${g.id}/`}>
                <span class="svc-guides__title">{g.data.title}</span>
                <span class="svc-guides__desc">{g.data.description}</span>
                <span class="svc-guides__meta">
                  {g.data.minutes} min read
                  <svg class="svc-guides__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 7h11M7.5 2.5 12 7l-4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container">
      <p class="svc-othercity">
        Covering the whole of Bristol and South Gloucestershire — every neighbourhood
        below has its own page under this service, with local context written for it.
      </p>

      <AreaCoverage
        serviceSlug={service.slug}
        eyebrow="Coverage"
        heading={`${serviceTitle} Across Bristol & South Gloucestershire`}
        lede={`All ${areaCount} Bristol-area neighbourhoods — the city, North and East Bristol, and the South Gloucestershire ring.`}
        note="Free consultation across the region. Businesses outside our standard coverage area can be quoted by arrangement. MTD-ready VAT filing and HMRC-compliant payroll come as standard."
      />
    </div>
  </section>
</PageLayout>

<style>
  .svc-guides {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    /* Two up on desktop. Full-width single-column cards were short and very
       wide, which read as unfinished rows rather than cards. */
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--sp-4);
    max-width: 1000px;
  }
  .svc-guides li { display: flex; }
  .svc-guides a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .svc-guides a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .svc-guides a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .svc-guides__arrow { transition: transform var(--dur-fast) var(--ease); }
  .svc-guides a:hover .svc-guides__arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .svc-guides a, .svc-guides__arrow { transition: none; }
    .svc-guides a:hover { transform: none; }
  }
  .svc-guides__title { font-size: var(--fs-md); font-weight: var(--weight-bold); color: var(--text); }
  .svc-guides__desc { font-size: var(--fs-sm); line-height: 1.6; color: var(--text-muted); }
  .svc-guides__meta {
    /* auto pushes the meta line to the bottom so the two cards agree on where
       it sits, whatever the description length */
    margin-top: auto;
    padding-top: var(--sp-3);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent-text);
  }

  .subsvc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--sp-3);
  }
  .subsvc__item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    scroll-margin-top: calc(var(--header-h, 5rem) + var(--sp-5));
  }
  .subsvc__name { margin: 0; font-size: var(--fs-md); font-weight: var(--weight-bold); color: var(--text); }
  .subsvc__summary { margin: 0; flex: 1; font-size: var(--fs-sm); line-height: 1.65; color: var(--text-muted); }
  .subsvc__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: var(--weight-semi);
    color: var(--accent-text);
    text-decoration: none;
  }
  .subsvc__cta:hover { text-decoration: underline; }

  .svc-othercity {
    max-width: 780px;
    margin: 0 auto var(--sp-6);
    text-align: center;
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--text-muted);
  }
  .svc-othercity a { color: var(--accent-text); font-weight: var(--weight-semi); }

  /* Intro: copy beside a photograph, no tinted panel. The callout styling
     made the opening paragraph look like an aside rather than the lead. */
  .intro-split {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--sp-7);
    align-items: center;
    margin: 0 0 var(--sp-7);
  }
  .intro-split__copy p {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 58ch;
  }
  .intro-split__media {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-sunken);
  }
  .intro-split__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .intro-split { grid-template-columns: 1fr; gap: var(--sp-5); }
    .intro-split__media { order: -1; }
  }
  @media (max-width: 640px) {
  }

  /* Page-local styles only — design system tokens from global.css */
  /* Narrow measure for readability, but anchored to the site grid so the
     headline starts on the same left edge as the header logo. Centring it
     put the h1 240px right of the logo. */


  /* Service bullets grid (8 bullets from service.whatWeDo) */
  .service-bullets {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 var(--sp-7);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-3);
  }
  .service-bullets li {
    background: #fff;
    border-left: 3px solid var(--accent);
    padding: var(--sp-4) var(--sp-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    box-shadow: var(--shadow-xs);
    color: var(--text);
    margin: 0;
  }

  /* Section headings alignment */
  .section-lede {
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-lg);
    max-width: 60ch;
    margin: 0 auto var(--sp-7);
  }

  /* Areas inline detail grid (replaces 12-card grid + 120 matrix pages) */
  .area-group-heading:first-of-type { margin-top: var(--sp-5); }
  .area-detail:hover { border-color: var(--surface-inverse); }

  /* ── Recent work grid ── */
  .work-grid-section { padding: var(--space-3xl, 4rem) 0; background: var(--surface-2, #f6f6f4); }
  .work-grid__eyebrow {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--accent-text); margin: 0 0 0.5rem;
  }
  .work-grid__heading { margin: 0 0 0.4rem; }
  .work-grid__lede { margin: 0 0 1.75rem; color: var(--text-muted, #555); max-width: 60ch; }
  .work-grid__more { margin: 1.5rem 0 0; font-size: var(--fs-sm); }
  .work-grid__more a { color: var(--accent-text); font-weight: var(--weight-semi); }
  .work-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1rem;
  }
  .work-grid__item { margin: 0; }
  /* Portrait interiors and landscape elevations sit in the same grid, so a
     fixed ratio keeps the rows even without distorting either. */
  .work-grid__item img {
    display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover;
    border-radius: 6px; background: var(--surface, #eee);
  }
  @media (max-width: 640px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  }

  /* ── Case-study band ── */
  .case-band {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--sp-5);
    max-width: 900px;
    margin: 0 auto;
  }
  .case-band__card {
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease),
                transform var(--dur-fast) var(--ease);
  }
  .case-band__card:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 30px rgba(13, 21, 32, 0.12);
    transform: translateY(-2px);
  }
  .case-band__media { position: relative; display: block; }
  .case-band__media img {
    width: 100%; height: auto; display: block;
    aspect-ratio: 3 / 2; object-fit: cover;
  }
  .case-band__count {
    position: absolute;
    bottom: var(--sp-3); right: var(--sp-3);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-inverse);
    background: rgba(13, 21, 32, 0.82);
    padding: 0.35rem 0.7rem;
  }
  .case-band__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: var(--sp-5);
  }
  .case-band__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--text);
  }
  .case-band__loc { font-size: 0.8rem; color: var(--text-muted); }
  .case-band__brief {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .case-band__go {
    margin-top: auto;
    padding-top: var(--sp-3);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
