---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceBullets from '../../components/ServiceBullets.astro';
import ReviewCards from '../../components/ReviewCards.astro';
import { getBathAreas, getArea, KEY_SERVICES } from '../../lib/areas';
import { SERVICES, getService, serviceHook, warrantyBadge } from '../../lib/services';
import type { Service } from '../../lib/services';
import type { Area } from '../../lib/areas';
import { REVIEWS, reviewsFor } from '../../lib/reviews';
import { getNote } from '../../lib/serviceAreaNotes';

// service × neighbourhood, Bristol & South Gloucestershire: 7 services ×
// every MB area. Matrix page budget: not every service × area pair earns a
// page. Tier rules:
//   primary areas get the FULL matrix;
//   secondary areas get only the key money services where a matrix page can
//   realistically rank.
export function getStaticPaths() {
  const areas = getBathAreas();
  const pairs: { params: { service: string; area: string }; props: { service: Service; area: Area } }[] = [];
  for (const service of SERVICES) {
    for (const area of areas) {
      if (area.tier === 'primary' || (area.tier === 'secondary' && KEY_SERVICES.has(service.slug))) {
        pairs.push({
          params: { service: service.slug, area: area.slug },
          props: { service, area },
        });
      }
    }
  }
  return pairs;
}

const { service, area } = Astro.props;

// Prose form: "Payroll Services" reads wrong mid-sentence.
const prose = service.shortName.replace(/\s+Services$/i, '');
const proseLower = prose.toLowerCase();

// Projects in this area that match this service. This is the one block that
// varies by BOTH axes, so it carries most of the per-page differentiation.
// On the MB mock there is no project gallery (honest-empty rule), so the
// keywords map stays slim and the block no-ops.
const KEYWORDS: Record<string, string[]> = {
  'bookkeeping':           ['ledger', 'reconciliation', 'books'],
  'payroll':               ['payroll', 'paye'],
  'vat-returns':           ['vat', 'mtd', 'making tax'],
  'self-assessment':       ['self assessment', 'tax return'],
  'bank-reconciliation':   ['reconciliation'],
  'management-accounts':   ['report', 'management accounts'],
  'cloud-accounting':      ['xero', 'quickbooks', 'sage', 'software'],
};
const keys = KEYWORDS[service.slug] ?? [];
// MB areas carry no nearbyProjects (no fabricated project gallery for a
// pitch mock) — the block below must no-op rather than crash.
const matched = (area.nearbyProjects ?? []).filter((p: string) =>
  keys.some((k) => p.toLowerCase().includes(k))
);

// Reviews for this area, narrowed to this service where we have them.
const areaReviews = REVIEWS.filter((r) => r.area === area.name);
const exact = areaReviews.filter((r) => r.service.toLowerCase().includes(proseLower));
const reviews = exact.length ? exact : areaReviews.length ? areaReviews : reviewsFor(`${service.slug}-${area.slug}`);
const reviewScope = exact.length ? `${prose} in ${area.name}` : areaReviews.length ? area.name : 'Bristol & South Gloucestershire';

// The one block that is true of this service in this area and nowhere
// else. Written by hand in src/lib/serviceAreaNotes.ts; the block is
// omitted until it exists rather than padded with something generic.
const note = getNote(service.slug, area.slug);

const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
// Capped at two. Cross-links to neighbouring areas.
const nearby = area.nearbyAreas
  .map((s: string) => getArea(s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a))
  .slice(0, 2);

const areaCount = getBathAreas().length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${prose} in ${area.name}, ${area.postcode}`,
  serviceType: prose,
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://www.mbbookkeepingandpayrollsolutions.co.uk/#organization',
    name: 'MB Bookkeeping & Payroll Solutions',
    telephone: '+447828742991',
  },
  areaServed: {
    '@type': 'Place',
    name: `${area.name}, ${area.postcode}`,
    address: { '@type': 'PostalAddress', addressLocality: area.name, postalCode: area.postcode, addressCountry: 'GB' },
  },
};
---

<PageLayout
  title={`${prose} in ${area.name} ${area.postcode} | ${serviceHook(service)}`}
  description={`${prose} in ${area.name}, ${area.postcode}. Free first consultation, clear pricing, ${warrantyBadge(service)}.`}
  canonical={`/${service.slug}/${area.slug}/`}
  ogImage={`/og/${service.slug}.jpg`}
  schema={schema}
  breadcrumbs={[
    { name: 'Our Services', href: '/our-services/' },
    { name: service.shortName, href: `/${service.slug}/` },
    { name: area.name, href: `/${service.slug}/${area.slug}/` },
  ]}
  ctaHeading={`${prose} in ${area.name}?`}
  ctaText={`Book a free consultation — we cover ${area.name} ${area.postcode} and the rest of Bristol and South Gloucestershire, with no pressure either way.`}
>
  <Hero
    size="compact"
    eyebrow={[`${area.name} · ${area.postcode}`, prose]}
    title={`${prose} in`}
    titleAccent={area.name}
    lede={area.intro}
    primaryCta={{ label: 'Book a Free Consultation', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+447828742991', display: '07828 742991' }}
    trust={['Free consultation', 'Accountant-ready books', warrantyBadge(service)]}
  />

  <!-- Area context, framed for this service -->
  <section class="section">
    <div class="container container--reading">
      {note && (
        <p class="sxa-note">{note}</p>
      )}
      <p class="sxa-lead">{service.longIntro}</p>
      <p class="sxa-lead">{area.longIntro}</p>
    </div>
  </section>

  <!-- Projects matching this service in this area (no-op on the mock — no
       fabricated project gallery) -->
  {matched.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Recent work</span>
          <h2>{prose} we've done in {area.name}</h2>
        </header>
        <ul class="sxa-projects">
          {matched.map((p: string) => <li>{p}</li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- What this service actually solves -->
  <section class="section section--alt">
    <div class="container">
      <ServiceBullets
        items={service.problems}
        variant="problem"
        columns={2}
        eyebrow="Problems we fix"
        heading={`When ${area.name} businesses call us about ${proseLower}`}
        lede="If any of these sound like your business, this is the service you want."
      />
    </div>
  </section>

  <!-- Local business stock for this area -->
  <section class="section">
    <div class="container">
      <ServiceBullets
        items={area.propertyTypes}
        variant="do"
        columns={3}
        eyebrow="Local business stock"
        heading={`The ${area.name} businesses we help`}
        lede={`What ${proseLower} typically involves for the businesses here.`}
      />
    </div>
  </section>

  {/* Cost section removed — area-level pricing must not be invented for a
      real business (CPRs 2008 concern). service.costGuide (generic UK
      guide ranges) is untouched and renders on the service hub instead. */}

  {/* "Real Project" case study removed — nothing invented for the mock.
      The CaseStudy component and the `caseStudy` entries in services.ts
      are untouched — this is only the render call, ready for real client
      stories with permission after signature. */}

  <!-- Local knowledge -->
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Local knowledge</span>
        <h2>Working with {area.name} businesses</h2>
      </header>
      <div class="sxa-facts">
        <div class="sxa-fact">
          <h3>Where we are</h3>
          <p>We cover all of Bristol — {area.name} included. Our office is on Reed Road in Yate, minutes up the road.</p>
        </div>
        <div class="sxa-fact">
          <h3>Landmarks we know</h3>
          <ul class="sxa-chips">{area.landmarks.map((l: string) => <li>{l}</li>)}</ul>
        </div>
        <div class="sxa-fact">
          <h3>Software</h3>
          <p>We work in Xero, QuickBooks, Sage and FreeAgent — whichever you already use.</p>
        </div>
        <div class="sxa-fact">
          <h3>MTD-ready</h3>
          <p>VAT returns are filed under Making Tax Digital from day one.</p>
        </div>
        <div class="sxa-fact">
          <h3>Your accountant, sorted</h3>
          <p>We hand your accountant clean, reconciled figures — year end gets cheaper and simpler.</p>
        </div>
      </div>
    </div>
  </section>

  {reviews.length > 0 && (
    <ReviewCards
      reviews={reviews}
      eyebrow="Reviews"
      heading={`What ${reviewScope} customers say`}
      lede="Words from the businesses we look after."
    />
  )}

  <!-- Cross-links: other services here, and this service nearby -->
  <section class="section section--alt">
    <div class="container">
      <div class="sxa-links">
        <div>
          <h3 class="sxa-links__title">Other services in {area.name}</h3>
          <ul class="sxa-links__list">
            {otherServices
              .filter((s) => area.tier === 'primary' || (area.tier === 'secondary' && KEY_SERVICES.has(s.slug)))
              .map((s) => (
              <li>
                <a href={`/${s.slug}/${area.slug}/`}>
                  {s.shortName.replace(/\s+Services$/i, '')} in {area.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="sxa-links__title">{prose} nearby</h3>
          <ul class="sxa-links__list">
            {nearby
              .filter((a) => a.tier === 'primary' || (a.tier === 'secondary' && KEY_SERVICES.has(service.slug)))
              .map((a) => (
              <li>
                <a href={`/${service.slug}/${a.slug}/`}>
                  {prose} in {a.name} <span>{a.postcode}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="sxa-faq">Questions about {proseLower}? See the <a href="/faqs/">FAQs</a>.</p>

      {/* Upward links. This page pointed at its service landing page and nothing
          else — no route back to the service hub, so the tail held authority it
          had no way to pass on. */}
      <ul class="sxa-up">
        <li>
          <a href={`/${service.slug}/`}>
            <span class="sxa-up__label">All {proseLower}</span>
            <span class="sxa-up__sub">All {areaCount} Bristol-area areas</span>
          </a>
        </li>
        <li>
          <a href="/our-services/">
            <span class="sxa-up__label">All services in {area.name}</span>
            <span class="sxa-up__sub">Seven services, {area.postcode}</span>
          </a>
        </li>
        <li>
          <a href="/contact/">
            <span class="sxa-up__label">Free consultation</span>
            <span class="sxa-up__sub">Bristol &amp; South Gloucestershire</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .sxa-up {
    list-style: none;
    margin: var(--sp-6) 0 0;
    padding: var(--sp-5) 0 0;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-3);
  }
  .sxa-up a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    height: 100%;
    padding: var(--sp-4);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .sxa-up a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .sxa-up__label { font-weight: var(--weight-semi); color: var(--text); font-size: var(--fs-sm); }
  .sxa-up__sub { font-size: var(--fs-xs); color: var(--text-muted); }

  .sxa-costs { list-style: none; margin: 0 auto; padding: 0; max-width: 780px; }
  .sxa-cost {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .sxa-cost:first-child { border-top: 1px solid var(--border); }
  .sxa-cost__type { font-weight: var(--weight-semi); color: var(--text); }
  .sxa-cost__price {
    font-weight: var(--weight-bold);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sxa-costs__note {
    max-width: 780px;
    margin: var(--sp-4) auto 0;
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .sxa-case { margin: 0; display: grid; gap: var(--sp-4); }
  .sxa-case > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--sp-4);
    align-items: baseline;
  }
  .sxa-case dt {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-on-dark);
  }
  .sxa-case dd { margin: 0; line-height: 1.7; }
  @media (max-width: 600px) {
    .sxa-case > div { grid-template-columns: 1fr; gap: var(--sp-1); }
    .sxa-cost { flex-direction: column; gap: var(--sp-1); }
  }

  /* Leads the page when present — it is the part that is specific to this
     service in this area. */
  .sxa-note {
    margin: 0 0 var(--sp-5);
    padding-left: var(--sp-5);
    border-left: 3px solid var(--accent);
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--text);
  }

  .sxa-lead { font-size: var(--fs-md); line-height: 1.75; color: var(--text-secondary); }

  .sxa-faq {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .sxa-faq a { color: var(--accent-text); font-weight: var(--weight-semi); }

  .sxa-projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-3);
    max-width: var(--container-narrow);
    margin-inline: auto;
  }
  .sxa-projects li {
    position: relative;
    padding: var(--sp-4) var(--sp-4) var(--sp-4) var(--sp-6);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .sxa-projects li::before {
    content: '';
    position: absolute;
    left: var(--sp-4);
    top: 1.35em;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .sxa-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: var(--sp-4);
  }
  .sxa-fact {
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .sxa-fact h3 {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
  }
  .sxa-fact p { margin: 0; font-size: var(--fs-sm); line-height: 1.6; color: var(--text-secondary); }
  .sxa-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .sxa-chips li {
    padding: var(--sp-1) var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .sxa-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-6);
  }
  .sxa-links__title {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
  }
  .sxa-links__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
  .sxa-links__list a {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .sxa-links__list a:hover { border-color: var(--accent); color: var(--accent-text); }
  .sxa-links__list span {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

</style>
