---
import { AREAS } from '../lib/areas';
import PageLayout from '../layouts/PageLayout.astro';
import { PROFILES, COMPANY } from '../lib/contact';
import SectionHeader from '../components/SectionHeader.astro';
import ReviewCards from '../components/ReviewCards.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Hero from '../components/Hero.astro';
import { SERVICES } from '../lib/services';
import { REVIEWS } from '../lib/reviews';

const featuredServices = SERVICES;
const featuredReviews = REVIEWS.slice(0, 3);

// Reviews: Aspect has 6 Google reviews (5.0) + 16 TrustATrader (4.6).
// Aggregate 4.7/22 — never inflate; see lib/reviews.ts AGGREGATE.
const heroStats = [
  { value: '5.0', suffix: '',  label: 'Google rating' },
  { value: '22+', suffix: '',  label: 'years in Bath' },
  { value: '£10M+', suffix: '', label: 'public liability' },
  { value: 'MCIOB', suffix: '', label: 'chartered builder' },
];

// Hero photo per service for the bento grid
// Card-sized WebP (760x475), not the full 1600px heroes. The grid was
// pulling 2.17MB of JPEG to fill six ~380px cards.
const serviceImages: Record<string, string> = {
  'builders-bath':          '/images/hero-james-bath-property-1.webp',
  'kitchen-fitters':        '/projects/custom-kitchen-refit-1.webp',
  'extension-builders':     '/projects/midford-garden-extension-1.webp',
  'loft-conversion':        '/projects/bath-loft-extension-1.webp',
  'renovation':             '/images/hero-home-loft.webp',
  'heritage-restoration':   '/images/hero-james-bath-property-8.webp',
  'new-build':              '/projects/frome-garage-conversion-1.webp',
  'stone-walling':          '/projects/garden-wall-landscaping-1.webp',
  'landscaping':            '/projects/bath-landscaping-1.webp',
  'plastering-rendering':   '/projects/chilcompton-rendering-1.webp',
  'painting-decorating':    '/images/hero-james-bath-property-3.webp',
  'property-maintenance':   '/projects/greenhouse-base-build-1.webp',
  'windows-doors':          '/images/hero-james-bath-property-6.webp',
  'bathroom-installers':    '/projects/luxury-bathroom-refit-1.webp',
};

// Gallery photos for the "Recent work" section
// Captions describe what is actually in each frame (see
// public/services/MANIFEST.md) rather than inventing locations. The
// commercial-* slides name the client (Asda, HSBC — both Bath, 2026);
// Richard confirmed both may be named.
// Each slide links to the service it demonstrates — real project photos
// become internal links to the pages that need them.
const galleryImages = [
  { src: '/projects/custom-kitchen-refit-1.webp',              slug: 'kitchen-fitters',       service: 'Kitchen Fitters',        caption: 'Custom kitchen refit, Bath — underfloor heating, large-format tiling', alt: 'Custom kitchen refit in Bath by Aspect Builds with quartz worktops and integrated appliances' },
  { src: '/projects/luxury-bathroom-refit-1.webp',             slug: 'bathroom-installers',   service: 'Bathroom Installers',    caption: 'Luxury bathroom refit — wall-hung basin, rainfall shower',             alt: 'Luxury bathroom refit in Bath by Aspect Builds with freestanding bath and rainfall shower' },
  { src: '/projects/midford-garden-extension-1.webp',          slug: 'extension-builders',    service: 'House Extensions',       caption: 'Midford garden extension — full-width glazing',                       alt: 'Garden extension in Midford by Aspect Builds with full-width glazing and open-plan living' },
  { src: '/projects/bath-loft-extension-1.webp',               slug: 'loft-conversion',       service: 'Loft Conversions',       caption: 'Bath loft extension — four rooms and ensuite',                       alt: 'Loft conversion in Bath by Aspect Builds with new staircase and Juliet balcony' },
  { src: '/projects/bath-landscaping-1.webp',      slug: 'landscaping',           service: 'Landscaping',            caption: 'Countryside landscaping — stone paving and borders',                 alt: 'Countryside garden landscaping near Bath by Aspect Builds with stone paving' },
  { src: '/projects/garden-wall-landscaping-1.webp',           slug: 'stone-walling',         service: 'Bath Stone Walling',     caption: 'Garden wall in natural Bath stone',                                  alt: 'Bath stone garden wall built by Aspect Builds with lime mortar joints' },
  { src: '/images/hero-james-bath-property-8.webp',    slug: 'heritage-restoration',  service: 'Heritage Restoration',   caption: 'Georgian villa renovation, Batheaston',                              alt: 'Georgian villa heritage renovation in Batheaston by Aspect Builds' },
  { src: '/projects/frome-garage-conversion-1.webp',           slug: 'new-build',             service: 'Garage Conversions',     caption: 'Frome garage conversion — warm habitable space',                     alt: 'Garage conversion in Frome by Aspect Builds transformed into habitable living space' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
  name: 'Aspect Builds & Maintenance Ltd',
  '@id': 'https://www.aspectbuilds.co.uk/#organization',
  telephone: '+441174094116',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '+441174094116',
        contactType: 'customer service',
        areaServed: 'GB',
        availableLanguage: 'English',
      },
      {
        '@type': 'ContactPoint',
        telephone: '+447961114662',
        contactType: 'customer service',
        areaServed: 'GB',
        availableLanguage: 'English',
      },
    ],
    // Consolidates this site with the same business elsewhere.
    sameAs: PROFILES,
    // Google reads these on the LocalBusiness for the knowledge panel.
    // image: real work, not the logo. logo: the square brand mark.
    // hasMap ties the entity to the Business Profile listing itself.
    image: [
    'https://www.aspectbuilds.co.uk/projects/midford-garden-extension-1.webp',
    'https://www.aspectbuilds.co.uk/projects/custom-kitchen-refit-1.webp',
    'https://www.aspectbuilds.co.uk/projects/bath-loft-extension-1.webp',
    ],
    logo: 'https://www.aspectbuilds.co.uk/icon-512.png',
    description:
    'Extensions, loft conversions, full house refurbishments, kitchens, bathrooms and heritage restoration across Bath and BANES. Fixed written quotes within 48 hours, MCIOB-chartered lead, 22+ years in Bath.',
    hasMap: 'https://maps.google.com/?cid=4018445236727357871',
    // The registered entity behind the trading name (Companies House 10957221).
    legalName: COMPANY.legalName,
    foundingDate: COMPANY.incorporated,
    identifier: {
      '@type': 'PropertyValue',
      name: 'Company number',
      value: COMPANY.number,
    },
      email: 'james.aspectbuilds@gmail.com',
  url: 'https://www.aspectbuilds.co.uk',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2 Fir Tree Cottages, Dunkerton',
    addressLocality: 'Bath',
    postalCode: 'BA2 8BS',
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    // Taken from the Google Business Profile itself. The previous values
    // were 655m out, which undercuts the NAP match Google is checking.
    latitude: 51.3562,
    longitude: -2.3661,
  },
  // The same entity described three times must describe its service area
  // the same way. Cities plus every named neighbourhood — more useful to
  // Google than two city names, and it stays in step with lib/areas.
  areaServed: [
    { '@type': 'City', name: 'Bath' },
    { '@type': 'City', name: 'Bradford on Avon' },
    { '@type': 'City', name: 'Trowbridge' },
    { '@type': 'City', name: 'Chippenham' },
    { '@type': 'City', name: 'Frome' },
    { '@type': 'City', name: 'Radstock' },
    { '@type': 'City', name: 'Corsham' },
    ...AREAS.map((a) => ({ '@type': 'Place', name: a.name })),
  ],
  priceRange: '££',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '13:00',
    },
  ],
  // GBP mirror: the same service list the profile carries (google.com mapping).
  // Site asserts what Google already sees — reinforces the entity match.
  knowsAbout: [
    'House extensions', 'Loft conversions', 'Kitchen fitting', 'Bathroom fitting',
    'House renovation', 'Heritage restoration', 'New build homes', 'Bath stone walling',
    'Landscaping', 'Plastering', 'Painting and decorating', 'Property maintenance',
    'Windows and doors', 'Listed building consent',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Aspect Builds Services',
    itemListElement: [
      { '@type': 'Offer', position: 1,  itemOffered: { '@type': 'Service', name: 'General Contractor', url: 'https://www.aspectbuilds.co.uk/bath-builders-bath/' } },
      { '@type': 'Offer', position: 2,  itemOffered: { '@type': 'Service', name: 'House Extensions', url: 'https://www.aspectbuilds.co.uk/bath-extension-builders/' } },
      { '@type': 'Offer', position: 3,  itemOffered: { '@type': 'Service', name: 'Loft Conversions', url: 'https://www.aspectbuilds.co.uk/bath-loft-conversion/' } },
      { '@type': 'Offer', position: 4,  itemOffered: { '@type': 'Service', name: 'Full House Refurbishments', url: 'https://www.aspectbuilds.co.uk/bath-renovation/' } },
      { '@type': 'Offer', position: 5,  itemOffered: { '@type': 'Service', name: 'Kitchen Design & Installation', url: 'https://www.aspectbuilds.co.uk/bath-kitchen-fitters/' } },
      { '@type': 'Offer', position: 6,  itemOffered: { '@type': 'Service', name: 'Bathroom Remodelling & Refurbishments', url: 'https://www.aspectbuilds.co.uk/bath-bathroom-installers/' } },
      { '@type': 'Offer', position: 7,  itemOffered: { '@type': 'Service', name: 'New Build Homes', url: 'https://www.aspectbuilds.co.uk/bath-new-build/' } },
      { '@type': 'Offer', position: 8,  itemOffered: { '@type': 'Service', name: 'Heritage & Listed Building Restoration', url: 'https://www.aspectbuilds.co.uk/bath-heritage-restoration/' } },
      { '@type': 'Offer', position: 9,  itemOffered: { '@type': 'Service', name: 'Bath Stone Walling', url: 'https://www.aspectbuilds.co.uk/bath-stone-walling/' } },
      { '@type': 'Offer', position: 10, itemOffered: { '@type': 'Service', name: 'Landscaping & Outdoor Works', url: 'https://www.aspectbuilds.co.uk/bath-landscaping/' } },
      { '@type': 'Offer', position: 11, itemOffered: { '@type': 'Service', name: 'Plastering & Rendering', url: 'https://www.aspectbuilds.co.uk/bath-plastering-rendering/' } },
      { '@type': 'Offer', position: 12, itemOffered: { '@type': 'Service', name: 'Painting & Decorating', url: 'https://www.aspectbuilds.co.uk/bath-painting-decorating/' } },
      { '@type': 'Offer', position: 13, itemOffered: { '@type': 'Service', name: 'Property Maintenance & Repairs', url: 'https://www.aspectbuilds.co.uk/bath-property-maintenance/' } },
      { '@type': 'Offer', position: 14, itemOffered: { '@type': 'Service', name: 'Windows & Doors Installation', url: 'https://www.aspectbuilds.co.uk/bath-windows-doors/' } },
    ],
  },
};
---

<PageLayout
  title="Aspect Builds | Bath's Builder Since 2004"
  description="Professional builders in Bath. Loft conversions, extensions, heritage restoration and property maintenance. Fixed quotes, clean sites, fully insured. Call 07498 158747."
  preloadImage="/hero-home.webp"
  canonical="/"
  schema={schema}
>
  <Hero
    eyebrow={['Bath · BANES · Wiltshire', 'Since 2004']}
    title="Bath's builders. Best projects,"
    titleAccent="zero surprises."
    lede="From Georgian stone restorations to contemporary extensions — fixed quotes, clean sites, no surprises."
    primaryCta={{ label: 'Get Your Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+441174094116', display: '07498 158747' }}
    image="/images/hero-james-bath-property-1.webp"
    stats={heroStats}
  />

  <!-- 2. SERVICES — 6 cards, uniform grid -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="What we deliver"
        heading="Fourteen services. One standard."
        lede="Every project — whether a heritage restoration in Bathwick or a modern extension in Keynsham — is governed by the same rigorous process."
      />
      <div class="service-grid reveal-stagger">
        {featuredServices.map((service, i) => (
          <ServiceCard
            slug={service.slug}
            shortName={service.shortName}
            tagline={service.tagline}
            imageSrc={serviceImages[service.slug]}
            number={String(i + 1).padStart(2, '0')}
            variant="default"
          />
        ))}
      </div>
      <p class="services-more">
        <a href="/our-services/">Compare all Aspect services and where we cover</a>
      </p>
    </div>
  </section>

  <!-- 3. PROJECT GALLERY — visual proof -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Recent work"
                heading="Recent projects across Bath & BANES"
        lede="A selection of recent projects across Bath and the surrounding towns."
      />
      <div class="slider">
        <div class="slider__track" id="work-slider" tabindex="0" role="region"
             aria-label="Recent projects — scrollable">
          {galleryImages.map((img, i) => (
            <figure class="slide">
              <a
                href={`/bath-${img.slug}/`}
                class="slide__link"
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  width="920"
                  height="613"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="slide__caption">
                  <span class="slide__service">{img.service}</span>
                  <span class="slide__title">{img.caption}</span>
                </figcaption>
              </a>
            </figure>
          ))}
        </div>

        <div class="slider__controls">
          <button type="button" class="slider__btn" data-dir="-1" aria-controls="work-slider" aria-label="Previous projects">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="slider__btn" data-dir="1" aria-controls="work-slider" aria-label="More projects">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
      <div class="gallery-cta">
        <a href="/our-work/" class="btn btn--ghost">See more of our work</a>
      </div>
    </div>
  </section>

  <!-- 3b. COMMERCIAL — named-client trust band -->
  <section class="section section--dark">
    <div class="container commercial-band">
      <div class="commercial-band__copy">
        <span class="eyebrow eyebrow--clay">Commercial</span>
        <h2>Not just homes</h2>
        <p>
          Beyond homes, Aspect Builds takes on commercial and landlord work across Bath
          &mdash; office refits, retail unit fit-outs, planned maintenance programmes and
          multi-property schedules &mdash; run to the same fixed-price, one-project-manager
          standard, with &pound;10M+ public liability cover.
        </p>
        <a href="/our-work/" class="btn btn--ghost-light">See recent projects</a>
      </div>
      <figure class="commercial-band__media">
        <img
          src="/projects/midford-garden-extension-2.webp"
          alt="Aspect Builds project in progress in Bath"
          width="920" height="613" loading="lazy" decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- 4. REVIEWS + TRUST — combined trust block -->
  <section class="section">
    <div class="container">
      <ReviewCards
        reviews={featuredReviews}
        heading="What Bath & BANES homeowners say"
        lede="Three of our most recent verified reviews."
      />

      <!-- Credentials row -->
      <div class="trust-row">
        <p class="trust-row__heading">Why homeowners choose Aspect:</p>
        <ul class="trust-row__marks">
          <li>
            <a href="https://www.trustatrader.com/traders/aspect-builds-maintenance-ltd-interior-refurbishment-bath-south" target="_blank" rel="noopener noreferrer" class="trustatrader-badge" aria-label="4.6 out of 5 from 16 verified TrustATrader reviews">
              <img src="/logos/trustatrader-logo.svg" alt="TrustATrader" width="64" height="64" loading="lazy" />
              <span class="trustatrader-badge__text"><strong>4.6 / 5</strong> <span>TrustATrader · 16 Reviews</span></span>
            </a>
          </li>
          <li>
            <a href="https://g.page/r/CSgqcByy81a7EBM/review" target="_blank" rel="noopener noreferrer" class="trustatrader-badge" aria-label="Rated 5 out of 5 on Google — 5 verified reviews">
              <span class="trustatrader-badge__text"><strong>5.0 / 5</strong> <span>Google · 5 Reviews</span></span>
            </a>
          </li>
          <li class="trust-row__fact">
            <strong>MCIOB</strong>
            <span>Chartered builder — fewer than 1 in 10 in Bath</span>
          </li>
          <li class="trust-row__fact">
            <strong>£10M+</strong>
            <span>public liability, AXA-verified</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
{/* Body link, not a nav link: a sitewide /blog/ entry would take ~3.5%
    of internal PageRank from the service pages. */}
<section class="section section--alt">
  {/* Not .container--reading: that class deliberately anchors a narrow column
      to the left grid edge so long-form copy lines up with the logo, which is
      right for /terms/, /blog/ and the rest. Here the block is meant to be
      centred, and the two intentions fought — the column hung left while the
      text centred inside it, putting this content 176px off centre. */}
  <div class="container guides-cta">
    <span class="eyebrow">Guides</span>
    <h2>Planning a build in Bath?</h2>
    <p class="lede">
      Straight answers on extension costs, loft conversion timelines, listed-building
      rules and choosing a builder — from what we find on site.
    </p>
    <p style="margin: 0;"><a class="btn btn--secondary" href="/blog/">Read our guides</a></p>
    <p class="guides-cta__faq">Quick answer instead? <a href="/faqs/">See the FAQs</a>.</p>
  </div>
</section>

</PageLayout>

<script>
  // Scroll reveal animations
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Skip animations — make everything visible immediately
      document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => observer.observe(el));

    // Recent-work slider — enhancement only. The track already scrolls by
    // swipe, trackpad and arrow keys with no JS; this just wires the
    // buttons and greys them out at each end.
    const track = document.getElementById('work-slider');
    if (track) {
      const step = () => {
        const slide = track.querySelector('.slide');
        return slide ? slide.getBoundingClientRect().width + 16 : track.clientWidth * 0.8;
      };
      const buttons = document.querySelectorAll('.slider__btn');
      const sync = () => {
        // The track has 2px of inline padding for the focus ring, and snap
        // points land on sub-pixel offsets, so scrollLeft never settles at
        // exactly 0 or exactly max. Without this tolerance the buttons
        // never grey out at either end.
        const EDGE = 6;
        const max = track.scrollWidth - track.clientWidth;
        buttons.forEach((b) => {
          const dir = Number(b.getAttribute('data-dir'));
          b.toggleAttribute(
            'disabled',
            dir < 0 ? track.scrollLeft <= EDGE : track.scrollLeft >= max - EDGE
          );
        });
      };
      buttons.forEach((b) => b.addEventListener('click', () => {
        track.scrollBy({ left: Number(b.getAttribute('data-dir')) * step(), behavior: 'smooth' });
      }));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync, { passive: true });
      sync();

      // On a touch device a horizontal swipe of the carousel ends in a
      // click on whichever slide is under the finger when it lifts — after
      // the scroll, usually not the slide the user was looking at, so they
      // land on a service page they never meant to open. If the finger
      // moved, or the track scrolled, between press and click, the gesture
      // was a swipe: swallow the click. Both pointer and touch events are
      // wired because some mobile browsers stop firing pointer events once
      // they take over the scroll.
      let startX = 0;
      let startY = 0;
      let startScroll = 0;
      let swiped = false;
      const arm = (x: number, y: number) => { startX = x; startY = y; startScroll = track.scrollLeft; swiped = false; };
      const move = (x: number, y: number) => {
        if (Math.abs(x - startX) > 8 || Math.abs(y - startY) > 8) swiped = true;
      };
      track.addEventListener('pointerdown', (e) => arm(e.clientX, e.clientY), { passive: true });
      track.addEventListener('pointermove', (e) => move(e.clientX, e.clientY), { passive: true });
      track.addEventListener('touchstart', (e) => { const t = e.touches[0]; if (t) arm(t.clientX, t.clientY); }, { passive: true });
      track.addEventListener('touchmove', (e) => { const t = e.touches[0]; if (t) move(t.clientX, t.clientY); }, { passive: true });
      track.addEventListener('click', (e) => {
        if (swiped || Math.abs(track.scrollLeft - startScroll) > 8) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);
    }

  });
</script>


<style>
  /* ==== RECENT WORK SLIDER ====
     Native CSS scroll-snap, not a carousel library. It scrolls with a
     swipe, a trackpad, the arrow keys or the buttons, and it works with
     JavaScript off — so it adds nothing to INP and can't block rendering.
     Every slide is a real <img> with alt text in the server-rendered HTML,
     so all fourteen stay crawlable and eligible for image search. */
  .slider { position: relative; }

  .slider__track {
    display: grid;
    grid-auto-flow: column;
    /* A percentage as the max of minmax() collapses to the min in a
       scrolling grid track, which pinned every slide at 420px. clamp()
       against the viewport gives the intended slide-and-a-half. */
    grid-auto-columns: clamp(280px, 54vw, 760px);
    gap: var(--sp-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    padding-bottom: var(--sp-4);
    /* room for the focus ring, which the overflow would otherwise clip */
    padding-inline: 2px;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  .slider__track:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }
  .slider__track::-webkit-scrollbar { height: 6px; }
  .slider__track::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: var(--radius-full);
  }

  .slide {
    scroll-snap-align: start;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-inverse);
  }

  .slide__link {
    position: relative;
    display: block;
    color: var(--text-inverse);
    text-decoration: none;
  }
  .slide__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-lg);
  }

  /* width/height on the img plus this ratio reserves the box before the
     file arrives, so lazy loading can't shift the layout (CLS) */
  .slide img {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .slide__link:hover img { transform: scale(1.03); }

  /* Caption sits on the photograph. The gradient is tall and opaque enough
     at the base to hold white text over any of the shots — several are
     bright renders, so a light scrim would not have been safe. */
  .slide__caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-8) var(--sp-5) var(--sp-5);
