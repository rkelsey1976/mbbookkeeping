---
import PageLayout from '../layouts/PageLayout.astro';
import { PROFILES, COMPANY, PHONE, LANDLINE, EMAIL, ADDRESS, HOURS, BRAND } from '../lib/contact';
import SectionHeader from '../components/SectionHeader.astro';
import ReviewCards from '../components/ReviewCards.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Hero from '../components/Hero.astro';
import { SERVICES } from '../lib/services';
import { AREAS } from '../lib/areas';
import { REVIEWS } from '../lib/reviews';

const featuredServices = SERVICES;
const featuredReviews = REVIEWS.slice(0, 3);

// Card thumbnails — 560px WebP crops of the hero photography (~8-15KB each).
const cardImages: Record<string, string> = {
  'bookkeeping':           '/hero/card-bookkeeping.webp',
  'payroll':               '/hero/card-payroll.webp',
  'vat-returns':           '/hero/card-vat-returns.webp',
  'self-assessment':       '/hero/card-self-assessment.webp',
  'bank-reconciliation':   '/hero/card-bank-reconciliation.webp',
  'management-accounts':   '/hero/card-management-accounts.webp',
  'cloud-accounting':      '/hero/card-cloud-accounting.webp',
};
const cardAlts: Record<string, string> = {
  'bookkeeping':           'Calculator on printed financial reports and charts',
  'payroll':               'Laptop showing a finance dashboard with charts and KPIs',
  'vat-returns':           'Tax paperwork and folders being reviewed at a desk',
  'self-assessment':       'Tax paperwork and folders being reviewed at a desk',
  'bank-reconciliation':   'Calculator on printed financial reports and charts',
  'management-accounts':   'Laptop showing a finance dashboard with charts and KPIs',
  'cloud-accounting':      'Laptop showing cloud accounting software',
};

// Stats must be structural truths only — no invented ratings, years or cover.
const heroStats = [
  { value: '7', suffix: '', label: 'bookkeeping & payroll services' },
  { value: '20', suffix: '', label: 'Bristol-area neighbourhoods' },
  { value: 'FREE', suffix: '', label: 'first consultation' },
  { value: 'MTD', suffix: '', label: 'Making Tax Digital ready' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'AccountingService'],
  name: 'MB Bookkeeping & Payroll Solutions',
  '@id': 'https://www.mbbookkeepingandpayrollsolutions.co.uk/#organization',
  telephone: '+447828742991',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+447828742991',
      contactType: 'customer service',
      areaServed: 'GB',
      availableLanguage: 'English',
    },
    {
      '@type': 'ContactPoint',
      telephone: '+441454447343',
      contactType: 'customer service',
      areaServed: 'GB',
      availableLanguage: 'English',
    },
  ],
  sameAs: PROFILES,
  logo: 'https://www.mbbookkeepingandpayrollsolutions.co.uk/icon-512.png',
  description:
    'Bookkeeping, payroll, VAT returns and MTD support, self assessment and management accounts for small businesses across Yate, Bristol and South Gloucestershire.',
  legalName: COMPANY.legalName,
  email: EMAIL,
  url: 'https://www.mbbookkeepingandpayrollsolutions.co.uk',
  address: {
    '@type': 'PostalAddress',
    streetAddress: ADDRESS.street,
    addressLocality: ADDRESS.locality,
    postalCode: ADDRESS.postcode,
    addressCountry: 'GB',
  },
  areaServed: AREAS.map((a) => ({ '@type': 'Place', name: a.name })),
  priceRange: '££',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '17:30',
    },
  ],
  knowsAbout: [
    'Bookkeeping', 'Payroll', 'VAT returns', 'Making Tax Digital', 'Self assessment',
    'Bank reconciliation', 'Management accounts', 'Cloud accounting', 'Xero', 'QuickBooks', 'Sage',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'MB Bookkeeping & Payroll Solutions Services',
    itemListElement: SERVICES.map((s, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: { '@type': 'Service', name: s.shortName, url: `https://www.mbbookkeepingandpayrollsolutions.co.uk/${s.slug}/` },
    })),
  },
};

// Group the areas by region for the coverage strip.
const regions: { region: string; areas: typeof AREAS }[] = [];
for (const a of AREAS) {
  const r = regions.find((g) => g.region === a.region);
  if (r) r.areas.push(a);
  else regions.push({ region: a.region, areas: [a] });
}
---

<PageLayout
  title="MB Bookkeeping & Payroll Solutions | Bookkeeper & Accounting Services, Bristol"
  description="Bookkeeping, payroll, VAT returns, self assessment and accounting support for small businesses across Bristol and South Gloucestershire. We keep your books right and your accountant happy. Free first consultation — call 07828 742991."
  canonical="/"
  schema={schema}
>
  <Hero
    eyebrow={['Bristol · South Gloucestershire', 'Free first consultation']}
    title="Your books done right,"
    titleAccent="your time back."
    lede="Bookkeeping, payroll and accounting support for small businesses across Yate, Bristol and South Gloucestershire — accurate ledgers your accountant will love, HMRC-compliant payroll and MTD-ready VAT, without you wrestling the spreadsheets."
    primaryCta={{ label: 'Book a Free Consultation', href: '/contact/#lead-form-heading' }}
    phone={{ number: PHONE.tel, display: PHONE.display }}
    image="/hero/hero-home.webp"
    imageAlt="Reviewing a printed financial dashboard with charts and a calculator on a desk"
    stats={heroStats}
  />

  <!-- 2. SERVICES — 7 cards, uniform grid -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="What we do"
        heading="Seven services. One tidy set of books."
        lede="From day-to-day bookkeeping and payroll to VAT, self assessment and management accounts — everything your accountant needs, kept accurate and on time."
      />
      <div class="service-grid reveal-stagger">
        {featuredServices.map((service, i) => (
          <ServiceCard
            slug={service.slug}
            shortName={service.shortName}
            tagline={service.tagline}
            imageSrc={cardImages[service.slug]}
            imageAlt={cardAlts[service.slug]}
            number={String(i + 1).padStart(2, '0')}
            variant="default"
          />
        ))}
      </div>
      <p class="services-more">
        <a href="/our-services/">Compare all services and where we cover</a>
      </p>
    </div>
  </section>

  <!-- 3. HOW IT WORKS — plain process, no invented claims -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="How it works"
        heading="From shoebox to sorted, in four steps"
        lede="No jargon and no lock-in — here's exactly how starting with MB works."
      />
      <ol class="steps-grid reveal-stagger">
        <li class="step-card">
          <span class="step-card__num">1</span>
          <h3>Free consultation</h3>
          <p>We talk through what you need — bookkeeping, payroll, VAT, the lot — and what it costs. No obligation.</p>
        </li>
        <li class="step-card">
          <span class="step-card__num">2</span>
          <h3>We get set up</h3>
          <p>We review your current records and software, then agree a way of working that fits how your business runs.</p>
        </li>
        <li class="step-card">
          <span class="step-card__num">3</span>
          <h3>We keep on top of it</h3>
          <p>Regular bookkeeping and payroll runs happen like clockwork, with bank reconciliations done and checked.</p>
        </li>
        <li class="step-card">
          <span class="step-card__num">4</span>
          <h3>You see the numbers</h3>
          <p>Clear monthly reports — who owes you, what you owe, and where you stand — ready for you and your accountant.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 4. SOFTWARE STRIP -->
  <!-- PITCH PROPOSAL: confirm software partners with the client before live build -->
  <section class="section">
    <div class="container">
      <div class="trust-row">
        <p class="trust-row__heading">We work with the software you already use</p>
        <ul class="trust-row__marks">
          <li class="trust-row__fact"><strong>Xero</strong><span>cloud bookkeeping</span></li>
          <li class="trust-row__fact"><strong>QuickBooks</strong><span>cloud bookkeeping</span></li>
          <li class="trust-row__fact"><strong>Sage</strong><span>desktop &amp; cloud</span></li>
          <li class="trust-row__fact"><strong>FreeAgent</strong><span>for sole traders &amp; landlords</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. COVERAGE — 20 Bristol-area neighbourhoods -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Where we cover"
        heading="Twenty neighbourhoods across Bristol and South Gloucestershire"
        lede="We cover the whole of Bristol — the city, the North and East suburbs and the surrounding towns — with a dedicated page for each area we serve. Our office is in Yate, on the North-East edge."
      />
      <div class="coverage-grid">
        {regions.map((g) => (
          <div class="coverage-group">
            <h3 class="coverage-group__region">{g.region}</h3>
            <ul class="coverage-group__list">
              {g.areas.map((a) => (
                <li>
                  <a class="coverage-pill" href={`/bookkeeping/${a.slug}/`}>
                    {a.name} <span class="coverage-pill__pcode">{a.postcode}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. ABOUT TEASER -->
  <section class="section">
    <div class="container media-split">
      <div class="media-split__copy">
        <span class="eyebrow">About</span>
        <h2>A Bristol bookkeeping and payroll practice</h2>
        <p>
          MB Bookkeeping &amp; Payroll Solutions looks after the books and accounting support for small businesses
          across Bristol and South Gloucestershire — accurate ledgers, payroll that runs
          on time, VAT returns filed under Making Tax Digital, and reports you can
          actually read. Our office is in Yate, so the North-East suburbs and South Glos
          towns are on our doorstep.
        </p>
        <p>
          You stay in your software of choice; we keep it reconciled and up to date, and
          your accountant gets clean figures at year end.
        </p>
        <a href="/about-us/" class="btn btn--secondary">More about MB</a>
      </div>
      <div class="media-split__media">
        <img
          src="/hero/hero-about.webp"
          alt="Working through accounts with a calculator and notebook"
          width="800" height="533" loading="lazy" decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- 7. REVIEWS — renders nothing while REVIEWS is empty (honest-empty rule) -->
  <section class="section">
    <div class="container">
      {featuredReviews.length > 0 && (
        <ReviewCards
          reviews={featuredReviews}
          heading="What local businesses say"
          lede="A few words from the businesses we look after."
        />
      )}
    </div>
  </section>

  <!-- 7b. GUIDES CTA — blog is empty at pitch stage, so link to FAQs instead -->
  <section class="section section--alt">
    <div class="container guides-cta">
      <span class="eyebrow">Questions?</span>
      <h2>Wondering how it all works?</h2>
      <p class="lede">
        Straight answers on what bookkeeping involves, how payroll runs, what MTD means
        for your VAT and how a bookkeeper works alongside your accountant.
      </p>
      <p style="margin: 0;"><a class="btn btn--secondary" href="/faqs/">Read the FAQs</a></p>
    </div>
  </section>

</PageLayout>

<script>
  // Scroll reveal animations
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Skip animations — make everything visible immediately
      document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => observer.observe(el));
  });
</script>

<style>
  /* ==== HOW IT WORKS — 4 step cards ==== */
  .steps-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-5);
  }
  @media (max-width: 900px) { .steps-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .steps-grid { grid-template-columns: 1fr; } }

  .step-card {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .step-card__num {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: var(--weight-bold);
    font-size: var(--fs-md);
  }
  .step-card h3 { margin: var(--sp-1) 0 0; font-size: var(--fs-lg); }
  .step-card p { margin: 0; color: var(--text-secondary); line-height: 1.6; }

  /* ==== COVERAGE STRIP ==== */
  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-5);
  }
  .coverage-group {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--sp-5);
  }
  .coverage-group__region {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--sp-3);
    color: var(--text-secondary);
  }
  .coverage-group__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .coverage-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    transition: border-color var(--dur-fast) var(--ease),
                background var(--dur-fast) var(--ease),
                transform var(--dur-fast) var(--ease);
  }
  .coverage-pill__pcode {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .coverage-pill:hover {
    border-color: var(--accent);
    background: var(--accent-tint);
    transform: translateY(-1px);
  }
  .coverage-pill:hover .coverage-pill__pcode { color: var(--accent-hover); }

  /* ==== ABOUT TILE — typographic brand block, no stock photo ==== */
  .about-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #002349 0%, #047F71 100%);
    color: #ffffff;
  }
  .about-tile__mark {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 1;
  }
  .about-tile__sub {
    font-size: var(--fs-sm);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .about-tile__loc {
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  /* Trust row fact chips (shared with software strip) */
  .trust-row__fact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    background: #f8f9fb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
  }
  .trust-row__fact strong { font-size: 1.1rem; color: var(--text); }
  .trust-row__fact span { font-size: 0.8rem; color: #666; }

  .guides-cta {
    max-width: var(--container-narrow);
    margin-inline: auto;
    text-align: center;
  }

  .services-more {
    margin: var(--sp-5) 0 0;
    text-align: center;
    font-size: var(--fs-sm);
  }
  .services-more a { color: var(--accent-text); font-weight: var(--weight-semi); }
</style>
<style is:global>
/* ==== SCROLL REVEAL ANIMATIONS ==== */
  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-stagger > * {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-stagger.is-visible > * {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-stagger.is-visible > *:nth-child(1) { transition-delay: 0.05s; }
    .reveal-stagger.is-visible > *:nth-child(2) { transition-delay: 0.12s; }
    .reveal-stagger.is-visible > *:nth-child(3) { transition-delay: 0.19s; }
    .reveal-stagger.is-visible > *:nth-child(4) { transition-delay: 0.26s; }
    .reveal-stagger.is-visible > *:nth-child(5) { transition-delay: 0.33s; }
    .reveal-stagger.is-visible > *:nth-child(6) { transition-delay: 0.40s; }
  }

  /* ==== UNIFORM CARD GRID (3-col desktop, 2-col tablet, 1-col mobile) ==== */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
  }

  @media (max-width: 900px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-4);
    }
  }

  @media (max-width: 600px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ==== MEDIA SPLIT (about teaser) ==== */
  .media-split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--sp-7);
    align-items: center;
  }
  @media (max-width: 860px) {
    .media-split { grid-template-columns: 1fr; gap: var(--sp-5); }
    .media-split__media { order: -1; }
  }
</style>