---
// Our Work — the case-study index. One card per project (cover photo, count,
// category, location) linking to the full study at /projects/{case}/.
// The old 101-photo wall duplicated each case page's gallery; the case pages
// carry every photo (all crawlable there). This page is the discovery layer.

import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';

const studies = (await getCollection('caseStudies'))
  .sort((a, b) => (b.data.gallery.length) - (a.data.gallery.length));

const caseSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Our Work — Case Studies',
  url: 'https://www.aspectbuilds.co.uk/our-work/',
  hasPart: studies.map((s) => ({
    '@type': 'Article',
    headline: s.data.title,
    url: `https://www.aspectbuilds.co.uk/projects/${s.id}/`,
  })),
};
---

<PageLayout
  title="Our Work | Case Studies | Aspect Builds"
  description="Ten real Aspect Builds projects across Bath and BANES — extensions, loft conversions, kitchen and bathroom refits, landscaping. 101 photos, full stories."
  preloadImage="/projects/midford-garden-extension-1.webp"
  canonical="/our-work/"
  schema={caseSchema}
  breadcrumbs={[{ name: 'Our Work', href: '/our-work/' }]}
  ctaHeading="Like what you see?"
  ctaText="Tell us about your project — we'll send a fixed written quote within 48 hours."
>
  <Hero
    size="compact"
    eyebrow={['Our work']}
    title="Recent projects across"
    titleAccent="Bath & BANES"
    lede="Ten real projects, told properly — the brief, the challenge, how we executed it, and every photograph from site. Extensions, loft conversions, kitchen and bathroom refits, landscaping and rendering."
    primaryCta={{ label: 'Get a Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+447498158747', display: '07498 158747' }}
    image="/projects/midford-garden-extension-1.webp"
    imageAlt="Garden extension in Midford by Aspect Builds with full-width glazing"
    rotateWith={[
      '/projects/custom-kitchen-refit-1.webp',
      '/projects/luxury-bathroom-refit-1.webp',
      '/projects/bath-loft-extension-1.webp',
      '/projects/bath-landscaping-1.webp',
      '/projects/frome-garage-conversion-1.webp',
    ]}
    trust={['10 case studies', '101 photos', 'Since 2004']}
  />

  <section class="section">
    <div class="container">
      <div class="case-index">
        {studies.map(({ id, data: d }) => (
          <a href={`/projects/${id}/`} class="case-card">
            <span class="case-card__media">
              <img
                src={d.image}
                alt={`${d.title} in ${d.location} by Aspect Builds`}
                width="920" height="613" loading="lazy" decoding="async"
              />
              <span class="case-card__count">{d.gallery.length} photos</span>
            </span>
            <span class="case-card__body">
              <span class="case-card__cat">{d.categoryLabel}</span>
              <span class="case-card__title">{d.title}</span>
              <span class="case-card__loc">{d.location}</span>
              <span class="case-card__brief">{d.brief}</span>
              <span class="case-card__go">
                Read the case study
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .case-index {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--sp-5);
  }
  .case-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease),
                transform var(--dur-fast) var(--ease);
  }
  .case-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md, 0 8px 30px rgba(13, 21, 32, 0.12));
    transform: translateY(-2px);
  }
  .case-card__media { position: relative; display: block; }
  .case-card__media img {
    width: 100%; height: auto; display: block;
    aspect-ratio: 3 / 2; object-fit: cover;
  }
  .case-card__count {
    position: absolute;
    bottom: var(--sp-3); right: var(--sp-3);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-inverse);
    background: rgba(13, 21, 32, 0.82);
    padding: 0.35rem 0.7rem;
  }
  .case-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: var(--sp-5);
  }
  .case-card__cat {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .case-card__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--text);
  }
  .case-card__loc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .case-card__brief {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .case-card__go {
    margin-top: auto;
    padding-top: var(--sp-3);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent-text);
  }
</style>
