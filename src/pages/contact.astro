---
import PageLayout from '../layouts/PageLayout.astro';
import { PROFILES, COMPANY, PHONE, LANDLINE, EMAIL, ADDRESS, HOURS, BRAND } from '../lib/contact';
import Hero from '../components/Hero.astro';
import { AREAS } from '../lib/areas';
import AreaCoverage from '../components/AreaCoverage.astro';
import LeadForm from '../components/LeadForm.astro';

// Single source of truth for NAP — must match the homepage schema exactly,
// or local ranking signals get diluted.
const nap = {
  name: BRAND.fullName,
  street: ADDRESS.street,
  locality: ADDRESS.locality,
  postcode: ADDRESS.postcode,
  phoneDisplay: PHONE.display,
  phoneHref: PHONE.tel,
  landlineDisplay: LANDLINE.display,
  landlineHref: LANDLINE.tel,
  email: EMAIL,
  lat: ADDRESS.lat,
  lng: ADDRESS.lng,
};

const hours = HOURS.filter((h) => h.opens).map((h) => ({
  days: h.days,
  time: `${h.opens} – ${h.closes}`,
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'AccountingService'],
  '@id': 'https://www.mbbookkeepingandpayrollsolutions.co.uk/#organization',
  name: nap.name,
  url: 'https://www.mbbookkeepingandpayrollsolutions.co.uk/contact/',
  telephone: '+447828742991',
  contactPoint: [
    { '@type': 'ContactPoint', telephone: '+447828742991', contactType: 'customer service', areaServed: 'GB', availableLanguage: 'English' },
    { '@type': 'ContactPoint', telephone: '+441454447343', contactType: 'customer service', areaServed: 'GB', availableLanguage: 'English' },
  ],
  sameAs: PROFILES,
  logo: 'https://www.mbbookkeepingandpayrollsolutions.co.uk/icon-512.png',
  description:
    'Bookkeeping, payroll, VAT returns and MTD support, self assessment and management accounts across Yate, Bristol and South Gloucestershire. Free first consultation.',
  legalName: COMPANY.legalName,
  email: nap.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: nap.street,
    addressLocality: nap.locality,
    postalCode: nap.postcode,
    addressCountry: 'GB',
  },
  geo: { '@type': 'GeoCoordinates', latitude: nap.lat, longitude: nap.lng },
  areaServed: AREAS.map((a) => ({ '@type': 'Place', name: a.name })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '17:30',
    },
  ],
  priceRange: '££',
};

const mapQuery = encodeURIComponent(`${nap.street}, ${nap.locality}, ${nap.postcode}`);
---

<PageLayout
  title="Contact MB Bookkeeping | Yate, Bristol & South Gloucestershire"
  description="Book a free consultation with MB Bookkeeping & Payroll Solutions. Call 07828 742991, email us, or send the form. Covering Bristol and South Gloucestershire."
  canonical="/contact/"
  schema={schema}
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
  showLeadForm={false}
  showCta={false}
>
  <Hero
    size="compact"
    eyebrow={['Contact']}
    title="Tell us about"
    titleAccent="your business."
    lede="Book a free consultation — we'll talk through your bookkeeping, payroll and VAT, and what it would cost. No pressure either way."
    primaryCta={{ label: 'Send us the details', href: '#lead-form-heading' }}
    phone={{ number: PHONE.tel, display: PHONE.display }}
    trust={['Free consultation', 'Bristol & South Glos', 'MTD-ready']}
    image="/hero/hero-contact.webp"
    imageAlt="Desk with calculator, notebook and financial charts"
  />

  <section class="section">
    <div class="container">
      <div class="contact-layout">
        <div class="contact-layout__main">
          <h2 id="lead-form-heading" class="contact-form-heading">Book your free consultation</h2>
          <p class="lede">
            Tell us what you need and we'll come back to you — a free consultation,
            with no obligation.
          </p>
          <LeadForm />
        </div>

        <aside class="contact-aside" aria-label="Contact details">
          <div class="contact-aside__block">
            <h3>Call or email</h3>
            <a href={`tel:${nap.phoneHref}`} class="contact-aside__phone">{nap.phoneDisplay}</a>
            <a href={`tel:${nap.landlineHref}`} class="contact-aside__email">{nap.landlineDisplay}</a>
            <a href={`mailto:${nap.email}`} class="contact-aside__email">{nap.email}</a>
          </div>

          <div class="contact-aside__block">
            <h3>Where we are</h3>
            <address class="contact-aside__address">
              {nap.street}<br />
              {nap.locality}, {nap.postcode}
            </address>
            <p class="contact-aside__note">Our office is in Yate — covering Bristol and South Gloucestershire.</p>
          </div>

          <div class="contact-aside__block">
            <h3>Opening hours</h3>
            <dl class="contact-aside__hours">
              {hours.map((h) => (
                <>
                  <dt>{h.days}</dt>
                  <dd>{h.time}</dd>
                </>
              ))}
            </dl>
          </div>

          <ul class="contact-aside__trust">
            <li>Free first consultation</li>
            <li>MTD-ready VAT support</li>
            <li>Xero, QuickBooks &amp; Sage</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Find us</h2>
      <p class="lede">18 Reed Road, Yate, Bristol BS37 7DR.</p>

      {/* Click-to-load: nothing is requested from Google until someone asks
          for the map, so the site really does load no third-party scripts by
          default — which is what the cookie policy says. */}
      <div class="map" data-map-src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}>
        <div class="map__facade">
          <p class="map__title">View the map</p>
          <p class="map__note">
            Loads Google Maps, which sets cookies. Nothing is requested until you choose to load it.
          </p>
          <button type="button" class="map__load btn btn--primary">Load map</button>
          <p class="map__alt">
            <a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener noreferrer">
              Or open directions in a new tab
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
        <AreaCoverage
          eyebrow="Coverage"
          heading="Areas we cover"
          lede={`${AREAS.length} neighbourhoods across Bristol and South Gloucestershire. Not listed? Ask — we can help.`}
        />
    </div>
  </section>
</PageLayout>

<script>
  // The map is a Google embed and sets Google cookies. Two ways in: the
  // visitor clicks "Load map", or they have already accepted cookies, in
  // which case the consent banner announces it and the map loads without a
  // second click. Rejecting — or not answering — leaves the facade up and
  // requests nothing from Google.
  const loadMap = (wrap: HTMLElement) => {
    const src = wrap.dataset.mapSrc;
    if (!src || wrap.dataset.loaded) return;
    wrap.dataset.loaded = 'true';
    const frame = document.createElement('iframe');
    frame.src = src;
    frame.title = 'Map showing 18 Reed Road, Yate, Bristol BS37 7DR';
    frame.loading = 'lazy';
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    frame.setAttribute('allowfullscreen', '');
    wrap.replaceChildren(frame);
  };

  const maps = () => document.querySelectorAll<HTMLElement>('.map');

  maps().forEach((wrap) => {
    wrap.querySelector('.map__load')?.addEventListener('click', () => loadMap(wrap));
  });

  if (document.documentElement.dataset.consent === 'accepted') maps().forEach(loadMap);
  window.addEventListener('kd:consent', (e) => {
    if ((e as CustomEvent).detail?.state === 'accepted') maps().forEach(loadMap);
  });
</script>

<style>
  /* Form first and widest — it is the reason the page exists. Details sit
     alongside as a reference column rather than above the ask. */
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr);
    gap: var(--sp-7);
    align-items: start;
  }
  .contact-form-heading { margin: 0 0 var(--sp-3); }
  .contact-layout__main .lede { margin-bottom: var(--sp-5); }

  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    /* stays in view while a long form is filled in */
    position: sticky;
    top: calc(var(--header-h, 72px) + var(--sp-4));
  }
  .contact-aside__block + .contact-aside__block {
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border);
  }
  .contact-aside h3 {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
  }

  .contact-aside__phone {
    display: block;
    font-size: var(--fs-lg);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-heading);
    font-variant-numeric: tabular-nums;
    color: var(--text);
    text-decoration: none;
  }
  .contact-aside__phone:hover { color: var(--accent-text); }
  .contact-aside__email {
    display: block;
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    word-break: break-word;
  }

  .contact-aside__address {
    font-style: normal;
    line-height: 1.6;
    margin: 0;
    color: var(--text-secondary);
  }
  .contact-aside__note {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .contact-aside__hours {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-2) var(--sp-4);
    margin: 0;
  }
  .contact-aside__hours dt { font-size: var(--fs-sm); color: var(--text-muted); }
  .contact-aside__hours dd {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--weight-semi);
    font-variant-numeric: tabular-nums;
  }

  .contact-aside__trust {
    list-style: none;
    margin: 0;
    padding: var(--sp-5) 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .contact-aside__trust li {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }
  .contact-aside__trust li::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; gap: var(--sp-6); }
    /* sticky is pointless once it is stacked below the form */
    .contact-aside { position: static; }
  }

  .map {
    margin-top: var(--sp-6);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-sunken);
  }
  .map :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .map__facade {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    text-align: center;
    padding: var(--sp-6);
  }
  .map__title { margin: 0; font-size: var(--fs-lg); font-weight: var(--weight-bold); }
  .map__note { margin: 0; max-width: 46ch; font-size: var(--fs-sm); color: var(--text-muted); }
  .map__alt { margin: 0; font-size: var(--fs-sm); }
</style>