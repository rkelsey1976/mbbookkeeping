---
// MB Bookkeeping & Payroll Solutions — brand lockup.
//
// Uses the client's actual logo file (/mb-logo.png, 2103×748, transparent
// background). Displayed at a fixed image height so the lockup keeps its
// designed proportions; `size` sets the cap height of the wordmark and the
// image scales from it (image height ≈ 1.9× cap height).

type Props = {
  variant?: 'inline' | 'mark' | 'stacked';
  /** Cap height of the wordmark in px. Image height ≈ 1.9× this. */
  size?: number;
  showTagline?: boolean;
  class?: string;
};

const {
  variant = 'inline',
  size = 26,
  showTagline = true,
  class: className = '',
} = Astro.props as Props;

const isMark = variant === 'mark';
const imgH = Math.round(size * 1.9);
---

<span
  class:list={['mb', `mb--${variant}`, className]}
  style={`--cap: ${size}px; --img-h: ${imgH}px`}
  role="img"
  aria-label="MB Bookkeeping & Payroll Solutions"
>
  <img
    class="mb__img"
    src="/mb-logo.png"
    alt="MB Bookkeeping & Payroll Solutions"
    width={2103}
    height={748}
  />
</span>

<style>
  .mb {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }
  .mb__img {
    display: block;
    height: var(--img-h, 48px);
    width: auto;
    flex-shrink: 0;
  }

  /* Stacked — centred, for footer / dark bands */
  .mb--stacked {
    flex-direction: column;
    align-items: center;
  }

  /* Dark-band variant: the logo's navy text vanishes on the dark footer,
     so sit it on a white chip — the original file shows untouched. */
  .mb--stacked .mb__img {
    background: #ffffff;
    border-radius: 8px;
    padding: 8px 10px;
  }

  .mb--mark { gap: 0; }
</style>