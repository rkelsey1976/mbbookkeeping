---
// ProcessTimeline — premium vertical timeline with numbered circles
// connected by a gradient line. Each step has icon + title + duration
// + description. Designed to feel like a real project timeline.

type Step = {
  title: string;
  description: string;
};

type Props = {
  eyebrow?: string;
  steps: Step[];
  heading?: string;
  lede?: string;
};

const { eyebrow, steps, heading, lede } = Astro.props as Props;

// Process icon per step (uses a focused set of workflow icons)
const stepIcons = [
  'phone',     // 1. Site visit
  'document',  // 2. Quote
  'scaffold',  // 3. Setup
  'hammer',    // 4. Prep
  'ruler',     // 5. Beading
  'paint',     // 6. Base coat
  'paint2',    // 7. Top coat
  'check',     // 8. Snag
  'shield',    // 9. Warranty
  'calendar',  // 10. Aftercare
];

const iconPaths: Record<string, string> = {
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  document: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>',
  scaffold: '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>',
  hammer: '<path d="M14 6l-7.4 7.4a2 2 0 0 0 0 2.8l1.2 1.2a2 2 0 0 0 2.8 0L18 9.8V6h-4z"/>',
  ruler: '<path d="M21.3 8.7L15.3 2.7a1 1 0 0 0-1.4 0L2.7 13.9a1 1 0 0 0 0 1.4l6 6a1 1 0 0 0 1.4 0L21.3 10.1a1 1 0 0 0 0-1.4z"/>',
  paint: '<path d="M19 11h2v8h-2zM9 2v8H7V2h2zm0 0V0h2v2H9zm12 0V0h2v2h-2zM2 9h8v2H2V9zm0 0V7h2v2H2zm6-7v8H6V2h2zm0 0V0h2v2H8z"/>',
  paint2: '<path d="M19 11h2v8h-2zM9 2v8H7V2h2zm0 0V0h2v2H9zm12 0V0h2v2h-2zM2 9h8v2H2V9zm0 0V7h2v2H2zm6-7v8H6V2h2zm0 0V0h2v2H8z"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
};
---

{heading && (
  <header class="process-header section-header section-header--center">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{heading}</h2>
    {lede && <p class="lede">{lede}</p>}
  </header>
)}

{/* Accordion rather than a flat list: ten expanded steps was 1,500px of
    scrolling. <details> keeps every step in the HTML for crawlers while
    showing one at a time. The first is open so the section never reads as
    an empty stack of bars. */}
<ol class="process-steps">
  {steps.map((step, i) => {
    const iconName = stepIcons[i] ?? stepIcons[i % stepIcons.length];
    const path = iconPaths[iconName] ?? iconPaths.check;
    return (
      <li>
        <details class="pstep" open={i === 0}>
          <summary class="pstep__head">
            <span class="pstep__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="pstep__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={path} />
            </span>
            <span class="pstep__title">{step.title}</span>
          </summary>
          <p class="pstep__desc">{step.description}</p>
        </details>
      </li>
    );
  })}
</ol>

<style>
  /* Dark band — the process is the trust-builder on these pages, so it gets
     its own ground rather than sitting in the same light section as
     everything else. Full-bleed via the wrapper in the page template. */
  .process-header {
    margin-bottom: var(--sp-6);
    text-align: center;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }
  /* This header sits on near-black. --accent-text (orange-700) is the
     AA-safe orange for LIGHT surfaces and drops to 3.51:1 here; the
     inverse token is 6.95:1. */
  .process-header .eyebrow { color: var(--accent-on-dark); }
  .process-header h2 { color: var(--text-inverse); }
  .process-header .lede { color: var(--text-inverse-muted); }

  .process-steps {
    list-style: none;
    /* auto, not 0 — the max-width capped the list but left it against the
       container's left edge while the header centred itself above it. */
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: var(--container-narrow);
  }

  .pstep {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease),
                background var(--dur-fast) var(--ease);
  }
  .pstep:hover { border-color: rgba(255, 255, 255, 0.28); }
  .pstep[open] {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--accent);
  }

  .pstep__head {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    min-height: 60px;
    cursor: pointer;
    list-style: none;
    color: var(--text-inverse);
  }
  .pstep__head::-webkit-details-marker { display: none; }
  .pstep__head:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--surface-inverse), 0 0 0 4px var(--accent);
    border-radius: var(--radius-md);
  }

  .pstep__num {
    flex: none;
    font-size: var(--fs-sm);
    font-weight: var(--weight-display);
    font-variant-numeric: tabular-nums;
    color: var(--accent-on-dark);
    min-width: 2ch;
  }

  .pstep__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: rgba(255, 107, 26, 0.14);
    color: var(--accent-on-dark);
  }

  .pstep__title {
    flex: 1;
    font-size: var(--fs-md);
    font-weight: var(--weight-semi);
    line-height: 1.35;
  }

  /* Chevron in CSS so the markup stays lean */
  .pstep__head::after {
    content: '';
    flex: none;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--accent-on-dark);
    border-bottom: 2px solid var(--accent-on-dark);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform var(--dur-fast) var(--ease);
  }
  .pstep[open] .pstep__head::after {
    transform: rotate(-135deg) translate(-2px, -2px);
  }

  .pstep__desc {
    margin: 0;
    /* line up under the title, past the number and icon */
    padding: 0 var(--sp-5) var(--sp-5) calc(var(--sp-5) + 2ch + var(--sp-4) + 34px + var(--sp-4));
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    color: var(--text-inverse-muted);
    max-width: var(--measure);
  }

  @media (max-width: 640px) {
    .pstep__head { gap: var(--sp-3); padding: var(--sp-4); }
    .pstep__icon { display: none; }
    .pstep__desc { padding: 0 var(--sp-4) var(--sp-4) calc(var(--sp-4) + 2ch + var(--sp-3)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pstep, .pstep__head::after { transition: none; }
  }
</style>
