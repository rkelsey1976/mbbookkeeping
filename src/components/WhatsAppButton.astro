---
// Floating WhatsApp button, mobile only.
//
// Mobile only on purpose: on desktop wa.me bounces through WhatsApp Web and
// a QR code, which is a worse experience than the phone number already in
// the header. On a phone it opens the app directly with the message
// prefilled.
//
// Renders nothing when no number is configured — see src/lib/contact.ts.

import { whatsappHref } from '../lib/contact';

type Props = {
  /** Override the prefilled message, e.g. with the service and area. */
  message?: string;
};
const { message } = Astro.props as Props;
const href = message ? whatsappHref(message) : whatsappHref();
---

{href && (
  <a
    class="wa"
    href={href}
    target="_blank"
    rel="noopener"
    aria-label="Message Aspect Builds on WhatsApp"
    data-wa
  >
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"/>
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.25-4.36c0-4.54 3.7-8.24 8.24-8.24a8.19 8.19 0 0 1 5.82 2.42 8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.25 8.23z"/>
    </svg>
    <span class="wa__label">WhatsApp</span>
  </a>
)}

<style>
  .wa {
    /* Hidden by default; only shown at the mobile breakpoint below. */
    display: none;
    position: fixed;
    right: var(--sp-4);
    /* Clear of the iOS home indicator and Android gesture bar. */
    bottom: calc(var(--sp-4) + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    align-items: center;
    gap: var(--sp-2);
    /* 52px tall — comfortably past the 44px minimum touch target. */
    min-height: 52px;
    padding: 0 var(--sp-4);
    border-radius: 999px;
    background: var(--surface-inverse);
    color: var(--text-inverse);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: var(--weight-bold);
    transition: transform var(--dur-fast) var(--ease),
                opacity var(--dur-mid) var(--ease);
  }
  .wa:active { transform: scale(0.96); }
  .wa__label { line-height: 1; }

  /* Slides out of the way while the mobile nav drawer is open, so it does
     not sit on top of the menu. */
  :global(body.nav-is-open) .wa {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .wa { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa { transition: none; }
  }
</style>
