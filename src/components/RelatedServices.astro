---
// RelatedServices — renders cross-links to related services using ServiceCard.
// Used on service hubs to encourage cross-service discovery.
// No card photography on the MB pitch mock (no stock images passed off as
// client work) — cards fall back to the generic icon.

import ServiceCard from './ServiceCard.astro';

type Service = {
  slug: string;
  shortName: string;
  tagline: string;
};

type Props = {
  eyebrow?: string;
  services: Service[];
  heading?: string;
  lede?: string;
};

const { eyebrow, services, heading = 'Related Services', lede = 'Customers who use this service often add one of these.' } = Astro.props as Props;
---

<section class="related-services" aria-labelledby="related-services-heading">
  <div class="container">
    <header class="section-header section-header--center">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {heading && <h2 id="related-services-heading">{heading}</h2>}
      {lede && <p class="lede">{lede}</p>}
    </header>
    <div class="related-services__grid">
      {services.map((s) => (
        <ServiceCard
          slug={s.slug}
          shortName={s.shortName}
          tagline={s.tagline}
          href={`/${s.slug}/`}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .related-services {
    padding: var(--sp-8) 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--sp-5);
  }

  .related-services h2 {
    text-align: center;
    margin-bottom: var(--sp-3);
  }

  .related-services .lede {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto var(--sp-6);
  }

  .related-services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-4);
  }
</style>
