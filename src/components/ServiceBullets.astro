---
// ServiceBullets — renders a service.description bullets array as cards.
// Each card has an icon (auto-derived from index) + headline + description.
// Used for "What We Do", "Common Problems", "Why Choose" sections.

export type Bullet = {
  title?: string;
  description: string;
};

type Props = {
  eyebrow?: string;
  items: string[] | Bullet[];
  variant?: 'do' | 'problem' | 'benefit';
  columns?: 2 | 3 | 4;
  heading?: string;
  lede?: string;
};

const {
  eyebrow,
  items,
  variant = 'do',
  columns = 4,
  heading,
  lede,
} = Astro.props as Props;

// Normalise items
const normalised: Bullet[] = (items as any[]).map((it) =>
  typeof it === 'string' ? { description: it } : it
);

// Icon set for each variant — different style per variant
const variantIcons: Record<string, string[]> = {
  do: [
    'check-circle', 'tool', 'color', 'shield', 'home', 'wrench',
    'paint', 'sparkle', 'layers', 'ruler', 'cube', 'star',
  ],
  problem: [
    'crack', 'moss', 'paint', 'damp', 'pebble', 'frost', 'broken',
  ],
  benefit: [
    'clock', 'piggy', 'water', 'breath', 'sun', 'shield', 'palette',
  ],
};

// Map icon names to inline SVGs (currentColor)
const iconPaths: Record<string, string> = {
  'check-circle': '<circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/>',
  'tool': '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  'color': '<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/>',
  'shield': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  'home': '<path d="M3 12L12 3l9 9M5 10v10h14V10"/>',
  'wrench': '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  'paint': '<path d="M19 11h2v8h-2zM9 2v8H7V2h2zm0 0V0h2v2H9zm12 0V0h2v2h-2zM2 9h8v2H2V9zm0 0V7h2v2H2zm6-7v8H6V2h2zm0 0V0h2v2H8z"/>',
  'sparkle': '<path d="M12 3l1.9 5.7L19 11l-5.1 2.3L12 19l-1.9-5.7L5 11l5.1-2.3L12 3z"/>',
  'layers': '<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>',
  'ruler': '<path d="M21.3 8.7L15.3 2.7a1 1 0 0 0-1.4 0L2.7 13.9a1 1 0 0 0 0 1.4l6 6a1 1 0 0 0 1.4 0L21.3 10.1a1 1 0 0 0 0-1.4z"/>',
  'cube': '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>',
  'star': '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  // problem icons
  'crack': '<path d="M12 2v6M12 22v-6M2 12h6M22 12h-6M4.93 4.93l4.24 4.24M14.83 14.83l4.24 4.24M4.93 19.07l4.24-4.24M14.83 9.17l4.24-4.24"/>',
  'moss': '<path d="M3 21h18M5 21V8c0-1 1-2 2-2h10c1 0 2 1 2 2v13M9 21V13h6v8"/>',
  'damp': '<path d="M12 2C8 6 5 11 5 15a7 7 0 0 0 14 0c0-4-3-9-7-13z"/>',
  'pebble': '<circle cx="6" cy="6" r="3"/><circle cx="14" cy="14" r="3"/><circle cx="18" cy="8" r="2"/><circle cx="9" cy="17" r="2"/>',
  'frost': '<path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07"/>',
  'broken': '<circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/>',
  // benefit icons
  'clock': '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  'piggy': '<path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-7.5-1.5-11 0-1.5-1.5-2.5-1-3 .5L1 9l1 1c0 1 1 2 2 2v5h14v-5c1 0 2-1 2-2l1-1-1-1c0-1-.5-2-2-2v-1z"/>',
  'water': '<path d="M12 2C8 6 5 11 5 15a7 7 0 0 0 14 0c0-4-3-9-7-13z"/>',
  'breath': '<path d="M3 12c0-5 4-9 9-9s9 4 9 9M3 12c0 5 4 9 9 9s9-4 9-9"/>',
  'sun': '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
  'palette': '<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.83 0 1.5-.67 1.5-1.5 0-.83-.5-1.5-.5-2.5 0-1 .5-2 2-2h2.5c2.5 0 4.5-2 4.5-4.5C22 6.5 17.5 2 12 2z"/>',
};
---

{heading && (
  <header class={`service-bullets__heading service-bullets__heading--${variant} section-header section-header--center`}>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{heading}</h2>
    {lede && <p class="lede">{lede}</p>}
  </header>
)}

<ul class={`service-bullets__grid service-bullets__grid--cols-${columns}`} data-variant={variant}>
  {normalised.map((item, i) => {
    const icons = variantIcons[variant] ?? variantIcons.do;
    const iconName = icons[i % icons.length];
    const path = iconPaths[iconName] ?? iconPaths['check-circle'];
    return (
      <li class={`service-bullets__item service-bullets__item--${variant}`}>
        <div class={`service-bullets__icon service-bullets__icon--${variant}`} aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={path} />
        </div>
        {item.title && <h3 class="service-bullets__title">{item.title}</h3>}
        <p class="service-bullets__desc">{item.description}</p>
      </li>
    );
  })}
</ul>

<style>
  .service-bullets__heading {
    margin-bottom: var(--sp-6);
    text-align: center;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }
  .service-bullets__heading h2 {
    margin: 0 0 var(--sp-3);
  }
  .service-bullets__heading .lede {
    max-width: 60ch;
  }

  .service-bullets__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .service-bullets__grid--cols-2 { grid-template-columns: repeat(2, 1fr); }
  .service-bullets__grid--cols-3 { grid-template-columns: repeat(3, 1fr); }
  .service-bullets__grid--cols-4 { grid-template-columns: repeat(4, 1fr); }

  @media (max-width: 900px) {
    .service-bullets__grid--cols-4 { grid-template-columns: repeat(2, 1fr); }
    .service-bullets__grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .service-bullets__grid--cols-2,
    .service-bullets__grid--cols-3,
    .service-bullets__grid--cols-4 { grid-template-columns: 1fr; }
  }

  .service-bullets__item {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--sp-5);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin: 0;
  }

  .service-bullets__item:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  /* Icon: coloured circle, different bg per variant */
  .service-bullets__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sp-2);
  }

  .service-bullets__icon--do {
    background: var(--accent-tint);
    color: var(--accent-text);
  }

  .service-bullets__icon--problem {
    background: var(--accent-tint);
    color: var(--accent-text);
  }

  .service-bullets__icon--benefit {
    background: var(--accent-tint);
    color: var(--accent-text);
  }

  .service-bullets__title {
    margin: 0;
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .service-bullets__desc {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }
</style>