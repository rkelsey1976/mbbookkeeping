---
// CtaBand — full-bleed call-to-action band that sits directly above the
// footer on every page.
//
// Namespaced `cta-band-*` deliberately: `.cta-banner` in global.css is still
// live on three pages, and reusing that name would have collided.
//
// Band background: Unsplash workspace photo (public/hero/hero-payroll.webp)
// under a brand-navy scrim — white text, teal accents. Swap for the client's
// own photography at live-build stage.

import { PHONE } from '../lib/contact';

type Props = {
  heading?: string;
  text?: string;
  /** Overrides the default CTA label. */
  ctaLabel?: string;
  ctaHref?: string;
};

const {
  heading = 'Book your free consultation',
  text = 'Free first consultation across Bristol and South Gloucestershire — talk it through with no pressure either way.',
  ctaLabel = 'Book a Free Consultation',
  ctaHref = '/contact/',
} = Astro.props as Props;

// Structural truths only — no invented proof points.
const proof = [
  'Free first consultation',
  'MTD-ready VAT and payroll',
  'Xero, QuickBooks & Sage',
  'Bristol & South Gloucestershire',
];
---

<section class="cta-band" aria-labelledby="cta-band-heading">
  <img
    class="cta-band__bg"
    src="/hero/hero-payroll.webp"
    alt=""
    width="1600"
    height="1139"
    loading="eager"
    decoding="async"
    aria-hidden="true"
  />
  <div class="cta-band__scrim" aria-hidden="true"></div>

  <div class="cta-band__inner">
    <p class="cta-band__eyebrow">
      <span class="cta-band__rule" aria-hidden="true"></span>
      Bristol &amp; South Gloucestershire
    </p>

    <h2 id="cta-band-heading" class="cta-band__heading">{heading}</h2>
    <p class="cta-band__text">{text}</p>

    <div class="cta-band__actions">
      <a href={ctaHref} class="cta-band__cta">
        <span>{ctaLabel}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
      <a href={`tel:${PHONE.tel}`} class="cta-band__phone">
        <span class="cta-band__phone-label">or call</span>
        <span class="cta-band__phone-num">{PHONE.display}</span>
      </a>
    </div>

    <ul class="cta-band__proof">
      {proof.map((item) => (
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    width: 100%;
    overflow: hidden;
    color: #ffffff;
    isolation: isolate;
  }

  /* Photo background + navy scrim (brand-matched) */
  .cta-band__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta-band__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(96deg,
        rgba(0, 35, 73, 0.94) 0%,
        rgba(0, 35, 73, 0.9) 40%,
        rgba(0, 35, 73, 0.8) 68%,
        rgba(0, 35, 73, 0.72) 100%),
      linear-gradient(to top,
        rgba(0, 35, 73, 0.6) 0%,
        rgba(0, 35, 73, 0.12) 38%);
  }

  .cta-band__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: clamp(3.5rem, 2rem + 5vw, 5.5rem) var(--gutter);
  }

  .cta-band__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-5);
    font-size: var(--fs-xs);
    font-weight: var(--weight-semi);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: rgba(255, 255, 255, 0.82);
  }
  .cta-band__rule { width: 32px; height: 2px; background: #7fd6c8; }

  .cta-band__heading {
    margin: 0 0 var(--sp-4);
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3rem);
    line-height: 1.1;
    /* The global h1–h6 rule sets color: var(--text) (dark navy) on every
       heading, which beats the band's inherited white. Set it explicitly. */
    color: #ffffff;
  }
  .cta-band__text {
    margin: 0 0 var(--sp-6);
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.7;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-6);
    margin: 0 0 var(--sp-7);
  }
  .cta-band__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    padding: 1rem 1.6rem;
    background: var(--brand-teal);
    color: #ffffff;
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: var(--weight-semi);
    transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .cta-band__cta:hover { background: #05957f; transform: translateY(-2px); }
  .cta-band__phone {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
  }
  .cta-band__phone-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: rgba(255, 255, 255, 0.75);
  }
  .cta-band__phone-num {
    font-size: var(--fs-lg);
    font-weight: var(--weight-display);
    font-variant-numeric: tabular-nums;
    color: #ffffff;
  }
  .cta-band__phone:hover .cta-band__phone-num { color: #7fd6c8; }

  .cta-band__proof {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
  }
  .cta-band__proof li {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: rgba(255, 255, 255, 0.85);
  }
  .cta-band__proof svg { color: #7fd6c8; flex: none; }

  @media (max-width: 640px) {
    .cta-band__actions { flex-direction: column; align-items: flex-start; }
  }
</style>