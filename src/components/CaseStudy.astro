---
// CaseStudy component — renders a single, large-format case study
// block with before/after, problem/solution, duration, cost, and result.
// Used on service city hubs.

export type CaseStudy = {
  title: string;
  location: string;
  propertyType: string;
  problem: string;
  solution: string;
  duration: string;
  costRange: string;
  result: string;
  beforeAlt: string;
  afterAlt: string;
};

type Props = {
  caseStudy: CaseStudy;
  areaName?: string;
};

const { caseStudy, areaName } = Astro.props as Props;
---

<aside class="case-study" aria-labelledby="case-study-heading">
  <div class="case-study-header">
    <span class="case-study-badge">Real Project</span>
    <h2 id="case-study-heading" class="case-study-title">{caseStudy.title}</h2>
  </div>

  <div class="case-study-meta">
    {areaName && <span class="case-study-tag">📍 {areaName}</span>}
    <span class="case-study-tag">🏠 {caseStudy.propertyType}</span>
    <span class="case-study-tag">⏱ {caseStudy.duration}</span>
    {caseStudy.costRange && <span class="case-study-tag">💷 {caseStudy.costRange}</span>}
  </div>

  <div class="case-study-grid">
    <div>
      <h3 class="case-study-step-heading">The Problem</h3>
      <p>{caseStudy.problem}</p>
    </div>
    <div>
      <h3 class="case-study-step-heading">Our Solution</h3>
      <p>{caseStudy.solution}</p>
    </div>
  </div>

  {/* The before/after pair here was two CSS gradients — a grey box and a
      black-to-green box — captioned as photographs of specific jobs
      ("1970s pebbledash render failing on a 1930s Bath semi…"). Removed
      rather than swapped for unrelated stock, which would just move the
      fabrication. Drop real before/after photos in and this comes back. */}

  <div class="case-study-result">
    <h3 class="case-study-step-heading">The Result</h3>
    <p>{caseStudy.result}</p>
  </div>
</aside>

<style>
  .case-study {
    background: linear-gradient(180deg, var(--surface-raised) 0%, var(--accent-tint) 100%);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: var(--sp-6);
    margin: var(--sp-7) 0;
    box-shadow: var(--shadow-sm);
  }
  .case-study-header {
    margin-bottom: 1rem;
  }
  .case-study-badge {
    display: inline-block;
    background: var(--surface-inverse);
    color: var(--text-inverse);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .case-study-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 1rem;
    color: var(--text);
    line-height: 1.3;
  }
  .case-study-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .case-study-tag {
    background: #fff;
    border: 1px solid var(--border-strong);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .case-study-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }
  .case-study-step-heading {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--text);
  }
  .case-study-result {
    background: #fff;
    border-left: 4px solid var(--accent);
    padding: 1rem 1.25rem;
    border-radius: 0 4px 4px 0;
    margin-top: 1rem;
  }
  @media (max-width: 700px) {
    .case-study-grid,
  }
</style>
