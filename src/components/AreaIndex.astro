---
// The neighbourhood grid on /bath/ and /bath/.
//
// Was a flat list of name + postcode + blurb, which across fifteen cards
// read as one grey block — nothing to scan by and nothing to choose on.
// Each card now leads with the postcode, states the dominant housing type
// (the thing that actually decides the specification) and marks where we
// have real work recorded. All of it comes from the area data; nothing is
// asserted here.

import type { Area } from '../lib/areas';
import { REGION_ORDER, type Region } from '../lib/areas';

type Props = { areas: Area[]; city?: string };
const { areas, city = 'bath' } = Astro.props as Props;

/** The area's own phrasing, minus the sq ft / value parenthetical. */
const dominant = (a: Area) => a.propertyTypes[0].replace(/\s*\([^)]*\)\s*$/, '').trim();

/** Group by region when the list is big enough to need scannable structure.
    Small lists (AreaHub's nearby block) render as one grid. */
const grouped = areas.length > 6
  ? REGION_ORDER
      .map((region) => ({ region, areas: areas.filter((a) => (a as Area).region === region) }))
      .filter((g) => g.areas.length > 0)
  : null;
---

{grouped ? (
  grouped.map((g) => (
    <section class="area-index__region">
      <h3 class="area-index__region-title">
        {g.region}
        <span class="area-index__region-count">{g.areas.length}</span>
      </h3>
      <ul class="area-index">
        {g.areas.map((a) => (
          <li>
            <a href={`/bath/${a.slug}/`}>
              <span class="area-index__head">
                <span class="area-index__pc">{a.postcode}</span>
                {a.nearbyProjects.length > 0 && (
                  <span class="area-index__work">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    {a.nearbyProjects.length} {a.nearbyProjects.length === 1 ? 'job' : 'jobs'} nearby
                  </span>
                )}
              </span>
              <span class="area-index__name">{a.name}</span>
              <span class="area-index__blurb">{a.blurb}</span>
              <span class="area-index__stock">
                <span class="area-index__stock-label">Mostly</span>
                {dominant(a)}
              </span>
              <span class="area-index__go">
                View area
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
) : (
  <ul class="area-index">
    {areas.map((a) => (
      <li>
        <a href={`/bath/${a.slug}/`}>
          <span class="area-index__head">
            <span class="area-index__pc">{a.postcode}</span>
            {a.nearbyProjects.length > 0 && (
              <span class="area-index__work">
                {a.nearbyProjects.length} {a.nearbyProjects.length === 1 ? 'job' : 'jobs'} nearby
              </span>
            )}
          </span>
          <span class="area-index__name">{a.name}</span>
          <span class="area-index__blurb">{a.blurb}</span>
          <span class="area-index__stock">
            <span class="area-index__stock-label">Mostly</span>
            {dominant(a)}
          </span>
          <span class="area-index__go">
            View area
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .area-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--sp-3);
  }
  .area-index a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    height: 100%;
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease),
                transform var(--dur-fast) var(--ease);
  }
  /* Accent rail, drawn on hover rather than always-on so fifteen cards
     do not read as fifteen alerts. */
  .area-index a::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-mid) var(--ease);
  }
  .area-index a:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }
  .area-index a:hover::before { transform: scaleY(1); }

  .area-index__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .area-index__pc {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
    padding: 0.2rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 3px;
  }
  .area-index__work {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--fs-xs);
    font-weight: var(--weight-semi);
    color: var(--text-muted);
  }
  .area-index__work svg { color: var(--accent-text); }

  .area-index__name {
    font-size: var(--fs-lg);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    color: var(--text);
  }
  .area-index__blurb {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--text-muted);
    flex: 1;
  }
  .area-index__stock {
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--text-secondary);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
  }
  .area-index__stock-label {
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    margin-right: 0.35rem;
  }
  .area-index__go {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: var(--weight-semi);
    color: var(--accent-text);
  }
  .area-index a:hover .area-index__go svg { transform: translateX(3px); }
  .area-index__go svg { transition: transform var(--dur-fast) var(--ease); }
  .area-index__region { margin: 0 0 var(--sp-5); }
  .area-index__region:last-child { margin-bottom: 0; }
  .area-index__region h3 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 var(--sp-4);
  }
  .area-index__region h3::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .area-index__region-count {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--accent-text);
    border: 1px solid var(--accent-text);
    padding: 1px 8px;
  }
</style>
